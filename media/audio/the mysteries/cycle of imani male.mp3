      { <span class="hljs-attr">id</span>: <span class="hljs-number">50</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Lineage"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Divine Spark"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"God resides within the living man. Walk with divine soul authority."</span> },
