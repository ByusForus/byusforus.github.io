    <span class="hljs-comment">// Render Matrix Buttons</span>
    <span class="hljs-keyword">const</span> mysteriesContainer = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'mysteries-buttons'</span>);
    mysteriesData.forEach(<span class="hljs-function">(<span class="hljs-params">item, idx</span>) =&gt;</span> {
      <span class="hljs-keyword">const</span> btn = <span class="hljs-built_in">document</span>.createElement(<span class="hljs-string">'button'</span>);
      btn.className = <span class="hljs-string">`doctrine-btn <span class="hljs-subst">${idx === <span class="hljs-number">0</span> ? <span class="hljs-string">'active'</span> : <span class="hljs-string">''</span>}</span>`</span>;
      btn.innerHTML = <span class="hljs-string">`&lt;span class="badge"&gt;<span class="hljs-subst">${item.id}</span>&lt;/span&gt; <span class="hljs-subst">${item.title}</span>`</span>;
      btn.onclick = <span class="hljs-function">() =&gt;</span> {
        <span class="hljs-built_in">document</span>.querySelectorAll(<span class="hljs-string">'#mysteries-buttons .doctrine-btn'</span>).forEach(<span class="hljs-function"><span class="hljs-params">b</span> =&gt;</span> b.classList.remove(<span class="hljs-string">'active'</span>));
        btn.classList.add(<span class="hljs-string">'active'</span>);
        <span class="hljs-keyword">const</span> box = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'mystery-display'</span>);
        box.style.opacity = <span class="hljs-string">'0.4'</span>;
        <span class="hljs-built_in">setTimeout</span>(<span class="hljs-function">() =&gt;</span> {
          <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'mystery-tag'</span>).innerText = <span class="hljs-string">`Mystery <span class="hljs-subst">${item.id}</span>`</span>;
          <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'mystery-title'</span>).innerText = item.title;
          <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'mystery-desc'</span>).innerText = item.desc;
          box.style.opacity = <span class="hljs-string">'1'</span>;
        }, <span class="hljs-number">120</span>);
      };
      mysteriesContainer.appendChild(btn);
    });

