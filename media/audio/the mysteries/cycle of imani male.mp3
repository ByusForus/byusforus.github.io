      <span class="hljs-keyword">const</span> audio = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'main-audio'</span>);
      audio.src = src;
      audio.play();

      <span class="hljs-built_in">document</span>.querySelectorAll(<span class="hljs-string">'.playlist-item'</span>).forEach(<span class="hljs-function"><span class="hljs-params">el</span> =&gt;</span> el.classList.remove(<span class="hljs-string">'active'</span>));
      event.currentTarget.classList.add(<span class="hljs-string">'active'</span>);
    }

    <span class="hljs-comment">// 99-Card Wisdom Engine</span>
    <span class="hljs-keyword">const</span> chattyDeck = [
      { <span class="hljs-attr">id</span>: <span class="hljs-number">1</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Checkmate Perspective"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Look three steps ahead of the distraction. A calculated response always disarms a sudden reaction."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">2</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Shield of Stillness"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Quiet observation holds more power than immediate combat. Protect your center at all costs."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">3</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Sovereign Board"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Never play on a board where your opponent writes the rules. Establish your own grid and control the squares."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">4</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Curious Consultant Tactic"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Ask the question that makes them confront their own assumptions. Truth reveals itself when prompted calmly."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">5</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Stealth Discipline"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Internal strength doesn't need external applause. Move in silence and let the results speak."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">6</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Specie Anchor"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Paper promises blow away with the wind. Sound money and land grants anchor true freedom."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">7</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Mastery of the Center"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Whoever commands the center commands the board. Protect your core principles from external dilution."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">8</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Strategic Non-Compliance"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Polite refusal to participate in degradation is the highest form of discipline and leverage."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">9</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Pillar Alignment"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Stand consciously between Boaz and Jachin. Balance intuitive vision with structured execution."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">10</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Silent Timing"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"The master does not strike when angry; the master moves when the board opens."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">11</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Boundary of Onyx"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"A boundary is not a wall of fear; it is an unshakeable standard of dignity."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">12</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Economic Fast"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"When you fast from spending, you test your sovereignty. Self-reliance begins at home."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">13</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Unborrowed Authority"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Never seek permission to exist from systems designed to profit from your compliance."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">14</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Solar Vision"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Keep your sight elevated above emotional traps. Let clarity guide your footsteps."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">15</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Lunar Intuition"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Trust the quiet pulse within. Discernment senses the move before it is made."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">16</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Sovereign Voice"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Speak only what aligns with your purpose. Idle chatter wastes strategic energy."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">17</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Code of Silence"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Keep internal plans within the sanctuary. A hidden move cannot be intercepted."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">18</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Lotus Root"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Even in murky waters, the golden lotus rises unsoiled and fully sovereign."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">19</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Generational Defense"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Defend the lineage first. Every strategy today shapes the freedom of tomorrow."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">20</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Calculated Position"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Position beats speed. Ensure your foundation is solid before advancing."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">21</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The True Creditor"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Know your standing. You are the builder and the creditor, not the debtor."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">22</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Calm Under Fire"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"When chaos swirls around the board, stillness is your greatest offensive weapon."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">23</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"No Assumptions"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Verify reality step by step. Assumptions are traps set by incomplete observation."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">24</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Sound Standard"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Gold and silver do not lie. Base your worth on sound truth, not borrowed credit."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">25</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Disciplined Rhythm"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Master the pace of your day. Consistency creates momentum that cannot be broken."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">26</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Internal Sanctuary"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Your mind is your temple. Guard what enters your ears and shapes your thoughts."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">27</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Sovereign Name"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"ImanI declares sovereign life. When you speak your true name, you reclaim your ground."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">28</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Strategic Leverage"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Leverage comes from holding what cannot be replaced: integrity, land, and truth."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">29</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Quiet Master"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"The wisest player at the table speaks the least and observes the most."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">30</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Ujamaa Economics"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Circulate value within your own circle before allowing it to flow outward."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">31</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Pillar of Strength"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Boaz stands firm against external pressure. Anchor yourself in unwavering law."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">32</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Pillar of Establishment"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Jachin establishes divine order. What is built on truth endures forever."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">33</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Master Stroke"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"When the path is clear, act with total conviction and leave nothing to chance."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">34</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Inner Mirror"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"See the divine reflection in your people. Unity begins with mutual recognition."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">35</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Guarded Gates"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Control the threshold of your sanctuary. Only peace and purpose enter here."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">36</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Subtle Deflection"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Let provocations pass through like wind. A ghost cannot be struck."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">37</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Ujima Responsibility"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Build together with those who share the same blueprint and code."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">38</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Sovereign Health"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Honor your physical vessel. Vitality is the engine of all strategic mastery."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">39</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The 101 Gate"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Stand between the ones and command the zero. You are the active center."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">40</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Unshakable Peace"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"True power is peace in the midst of provocation. Master your reaction."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">41</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Lineage Wisdom"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Draw upon ancestral resilience. You carry generations of unyielding courage."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">42</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Specie Principle"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Hold what has intrinsic weight. Do not trade real substance for illusions."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">43</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Stealth Guidance"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Lead by asking the question that plants the seed without causing conflict."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">44</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Golden Standard"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"High value is non-negotiable. Carry yourself as sovereign nobility."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">45</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Emerald Staff"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Awaken each morning with clear direction. The staff grounds your authority."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">46</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Onyx Shield"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Let nothing compromise your spiritual identity. Your shield deflects all noise."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">47</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Mastery Over Emotion"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Emotion clouds the chessboard. Cool intelligence wins the match."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">48</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Sovereign Narrative"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Tell your own story before others draft a chapter that diminishes you."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">49</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Economic Fast Power"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"A unified economic fast speaks louder than a thousand chaotic protests."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">50</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Divine Spark"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"God resides within the living man. Walk with divine soul authority."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">51</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Strategic Stillness"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"When you do not know the next move, stand still. Clarity will find you."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">52</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Sacred Union"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Harmonize the Sun and Moon within yourself before seeking external balance."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">53</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Clear Boundaries"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Good boundaries preserve peace. Define your lines with total precision."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">54</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Uproot the Weed"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Remove negative habits early before they entangle your strategic path."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">55</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Sound Mind"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Cultivate discipline in thought. A focused mind creates clear outcomes."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">56</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Sovereign Walk"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Step with measured intent. Every step on your land is a sovereign claim."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">57</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Restitution of Spirit"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"First restore your identity; external restitution will follow rightful standing."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">58</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Silent Watcher"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Observe patterns over time. Repeated behaviors reveal true intent."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">59</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Sacred Affirmation"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"I M ani: I am very beautiful, complete, and unborrowed."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">60</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Protected Ground"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Do not negotiate your foundation with anyone who does not respect your code."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">61</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Checkmate Move"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"When the board is aligned, move forward without hesitation or fear."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">62</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Independent Assets"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Own what you produce. Dependency is the counterfeit of freedom."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">63</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Quiet Pause"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Take time to rest and recharge. A sharp mind requires regular renewal."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">64</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Inner Sovereignty"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"No external authority can govern a mind that has fully awakened to truth."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">65</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Lotus Shield"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Grace combined with unyielding strength creates an impenetrable defense."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">66</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Truth as Armor"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Speak without deceit. Truth needs no defense and stands on its own."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">67</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Strategic Patience"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Rushing ruins the move. Wait for the exact opening before striking."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">68</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Divine Balance"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Keep the scales even between spiritual depth and practical execution."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">69</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Lineage Protection"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Protect the children and the elders. They are the roots and the branches."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">70</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Sound Wealth"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"True wealth is health, land, knowledge, and self-determination."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">71</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Consultant's Grace"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Guide with patience. A seed planted in curiosity grows into conviction."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">72</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Unbreakable Will"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Let your resolve be like tempered onyx—unyielding and deeply grounded."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">73</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Sovereign Beacon"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Light the path for others by walking in absolute integrity and faith."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">74</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Stealth Fortification"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Build your reserves before winter arrives. Preparation guarantees peace."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">75</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Alpha Standard"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Start every endeavor with pure intention and divine alignment."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">76</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Omega Shield"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Finish what you begin. Completion secures the generational victory."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">77</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Sovereign Creed"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Faith in action transforms the condition of the people into sovereign power."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">78</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Board Master"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Study the entire field, not just the nearest square. Vision wins the war."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">79</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Sacred Heritage"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Honor your lineage history. Forgetting your origin weakens your future."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">80</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Silent Anchor"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Anchor your heart in divine love; it is the source of all real strength."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">81</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Pillar Balance"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Stand tall between Boaz and Jachin. Let balance guide every decision."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">82</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Specie Reserve"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Store your treasures in real value. Let paper remain outside your sanctuary."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">83</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Economic Integrity"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Do not sell your birthright for temporary conveniences."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">84</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Curious Path"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Listen more than you speak. Insight is gained through quiet curiosity."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">85</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Lotus Grace"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Purity of character is your highest crown. Wear it with sovereign pride."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">86</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The True Defense"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"A righteous cause defended with calm strategy is invincible."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">87</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Sovereign Mindset"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"You are not a subject of external systems; you are sovereign by origin."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">88</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Shielded Thoughts"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Filter out chaotic frequencies. Tune your mind to high divine purpose."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">89</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Tactical Pause"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"When challenged, pause and breathe. That second of silence gives you control."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">90</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The 101 Awakening"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Step through the initiation of truth. Walk as the sovereign new breed."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">91</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Sovereign Economy"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Create value from your own hands, mind, and soil. Self-reliance is power."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">92</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Onyx Standard"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Black is a condition; Onyx is sovereign nobility, density, and value."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">93</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Gold Standard"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Gold represents destiny fulfilled. Never settle for less than your value."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">94</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Emerald Standard"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Emerald is rebirth and awakening. Rise anew with each rising sun."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">95</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Mastery of Speech"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Let your words be few, precise, and impeccable. Speak life into existence."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">96</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Sovereign Code"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Live by the ten activities in harmony. Complete mastery brings complete peace."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">97</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Final Checkmate"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"When truth is spoken without fear, all illusions collapse in checkmate."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">98</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Eternal Circle"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"From Alpha to Omega, the divine soul remains unbroken and victorious."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">99</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Sovereign Crown"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"You are ImanI: sovereign, faithful, and beautiful. Stand firm in your power."</span> }
    ];

    <span class="hljs-keyword">let</span> lastDrawnIndex = <span class="hljs-number">0</span>;

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">drawWisdomCard</span>(<span class="hljs-params"></span>) </span>{
      <span class="hljs-keyword">const</span> container = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'wisdom-card-container'</span>);
      container.style.opacity = <span class="hljs-string">'0.5'</span>;
      
      <span class="hljs-built_in">setTimeout</span>(<span class="hljs-function">() =&gt;</span> {
        <span class="hljs-keyword">let</span> randomIndex;
        <span class="hljs-keyword">do</span> {
          randomIndex = <span class="hljs-built_in">Math</span>.floor(<span class="hljs-built_in">Math</span>.random() * chattyDeck.length);
        } <span class="hljs-keyword">while</span> (randomIndex === lastDrawnIndex &amp;&amp; chattyDeck.length &gt; <span class="hljs-number">1</span>);

        lastDrawnIndex = randomIndex;
        <span class="hljs-keyword">const</span> card = chattyDeck[randomIndex];

        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'deck-title'</span>).innerText = card.title;
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'deck-quote'</span>).innerText = <span class="hljs-string">`"<span class="hljs-subst">${card.quote}</span>"`</span>;
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'deck-number'</span>).innerText = <span class="hljs-string">`Card #<span class="hljs-subst">${<span class="hljs-built_in">String</span>(card.id).padStart(<span class="hljs-number">2</span>, <span class="hljs-string">'0'</span>)}</span> of 99`</span>;

        container.style.opacity = <span class="hljs-string">'1'</span>;
      }, <span class="hljs-number">150</span>);
    }
  </span><span class="hljs-tag">&lt;/<span class="hljs-name">script</span>&gt;</span>
