      { <span class="hljs-attr">id</span>: <span class="hljs-number">57</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Lineage"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Restitution of Spirit"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"First restore your identity; external restitution will follow rightful standing."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">58</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Stealth"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Silent Watcher"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Observe patterns over time. Repeated behaviors reveal true intent."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">59</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Lineage"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Sacred Affirmation"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"I M ani: I am very beautiful, complete, and unborrowed."</span> },
