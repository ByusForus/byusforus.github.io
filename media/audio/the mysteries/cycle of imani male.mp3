    <span class="hljs-keyword">const</span> codesData = [
      { <span class="hljs-attr">id</span>: <span class="hljs-string">"01"</span>, <span class="hljs-attr">btnTitle</span>: <span class="hljs-string">"Code of Silence"</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Operational Code"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Code of Silence"</span>, <span class="hljs-attr">desc</span>: <span class="hljs-string">"Moving in stealth mode without broadcasting internal maneuvers, operations, or economic strategies to outside entities."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-string">"02"</span>, <span class="hljs-attr">btnTitle</span>: <span class="hljs-string">"Code of Non-Compliance"</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Operational Code"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Code of Non-Compliance"</span>, <span class="hljs-attr">desc</span>: <span class="hljs-string">"Refusing compliance with narratives, programs, or traditions that dilute sovereignty, character, or economic independence."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-string">"03"</span>, <span class="hljs-attr">btnTitle</span>: <span class="hljs-string">"Curious Consultant Method"</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Operational Code"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Curious Consultant Method"</span>, <span class="hljs-attr">desc</span>: <span class="hljs-string">"Guiding conversations by asking disarming, reflective questions that lead others to self-evident truth rather than arguing."</span> }
    ];

    <span class="hljs-keyword">const</span> boycottData = [
      { <span class="hljs-attr">id</span>: <span class="hljs-string">"01"</span>, <span class="hljs-attr">btnTitle</span>: <span class="hljs-string">"3 + 1 + 3 Formula"</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"The Formula"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"3 + 1 + 3 = 7-Day Economic Fast"</span>, <span class="hljs-attr">desc</span>: <span class="hljs-string">"Observed every Federal Holiday: three days of strategic preparation and economic pause before the holiday, one sacred day of sovereign reflection on the holiday, and three days of continued economic discipline following it."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-string">"02"</span>, <span class="hljs-attr">btnTitle</span>: <span class="hljs-string">"Silent Solution"</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"The Purpose"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Silent Solution Quiet Movement"</span>, <span class="hljs-attr">desc</span>: <span class="hljs-string">"This isn't a protest—it is a celebration. A peaceful, silent economic fast that preserves community value, builds total self-reliance, and honors our lineage and independence from within."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-string">"03"</span>, <span class="hljs-attr">btnTitle</span>: <span class="hljs-string">"Unity in Motion"</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"The Spirit"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Unity in Motion"</span>, <span class="hljs-attr">desc</span>: <span class="hljs-string">"Circulating economic resources within our own circles, stepping off commercial tracks, and standing together in quiet strength, dignity, and collective solidarity."</span> }
    ];

    <span class="hljs-comment">// 11. Matrix Buttons Render Function</span>
    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">renderMatrixButtons</span>(<span class="hljs-params">containerId, data, tagId, titleId, descId, boxId, extraHandler = <span class="hljs-literal">null</span></span>) </span>{
      <span class="hljs-keyword">const</span> container = <span class="hljs-built_in">document</span>.getElementById(containerId);
      data.forEach(<span class="hljs-function">(<span class="hljs-params">item, idx</span>) =&gt;</span> {
        <span class="hljs-keyword">const</span> btn = <span class="hljs-built_in">document</span>.createElement(<span class="hljs-string">'button'</span>);
        btn.className = <span class="hljs-string">`doctrine-btn <span class="hljs-subst">${idx === <span class="hljs-number">0</span> ? <span class="hljs-string">'active'</span> : <span class="hljs-string">''</span>}</span>`</span>;
        btn.innerHTML = <span class="hljs-string">`&lt;span class="badge"&gt;<span class="hljs-subst">${item.id}</span>&lt;/span&gt; <span class="hljs-subst">${item.btnTitle || item.title}</span>`</span>;
        btn.onclick = <span class="hljs-function">() =&gt;</span> {
          <span class="hljs-built_in">document</span>.querySelectorAll(<span class="hljs-string">`#<span class="hljs-subst">${containerId}</span> .doctrine-btn`</span>).forEach(<span class="hljs-function"><span class="hljs-params">b</span> =&gt;</span> b.classList.remove(<span class="hljs-string">'active'</span>));
          btn.classList.add(<span class="hljs-string">'active'</span>);
          <span class="hljs-keyword">const</span> box = <span class="hljs-built_in">document</span>.getElementById(boxId);
          box.style.opacity = <span class="hljs-string">'0.4'</span>;
          <span class="hljs-built_in">setTimeout</span>(<span class="hljs-function">() =&gt;</span> {
            <span class="hljs-built_in">document</span>.getElementById(tagId).innerText = item.tag || <span class="hljs-string">`Mystery <span class="hljs-subst">${item.id}</span>`</span>;
            <span class="hljs-built_in">document</span>.getElementById(titleId).innerText = item.title;
            <span class="hljs-built_in">document</span>.getElementById(descId).innerHTML = item.desc;
            <span class="hljs-keyword">if</span> (extraHandler) extraHandler(item);
            box.style.opacity = <span class="hljs-string">'1'</span>;
          }, <span class="hljs-number">120</span>);
        };
        container.appendChild(btn);
      });
    }

    renderMatrixButtons(<span class="hljs-string">'origins-buttons'</span>, originsData, <span class="hljs-string">'origin-tag'</span>, <span class="hljs-string">'origin-title'</span>, <span class="hljs-string">'origin-desc'</span>, <span class="hljs-string">'origin-display'</span>);
    renderMatrixButtons(<span class="hljs-string">'mysteries-buttons'</span>, mysteriesData, <span class="hljs-string">'mystery-tag'</span>, <span class="hljs-string">'mystery-title'</span>, <span class="hljs-string">'mystery-desc'</span>, <span class="hljs-string">'mystery-display'</span>);
    renderMatrixButtons(<span class="hljs-string">'activities-buttons'</span>, activitiesData, <span class="hljs-string">'activity-tag'</span>, <span class="hljs-string">'activity-title'</span>, <span class="hljs-string">'activity-desc'</span>, <span class="hljs-string">'activity-display'</span>);
    renderMatrixButtons(<span class="hljs-string">'restitution-buttons'</span>, restitutionData, <span class="hljs-string">'restitution-tag'</span>, <span class="hljs-string">'restitution-title'</span>, <span class="hljs-string">'restitution-desc'</span>, <span class="hljs-string">'restitution-display'</span>, <span class="hljs-function">(<span class="hljs-params">item</span>) =&gt;</span> {
      <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'restitution-gold'</span>).innerText = item.gold;
      <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'restitution-silver'</span>).innerText = item.silver;
      <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'restitution-rule'</span>).innerText = item.rule;
    });
    renderMatrixButtons(<span class="hljs-string">'codes-buttons'</span>, codesData, <span class="hljs-string">'code-tag'</span>, <span class="hljs-string">'code-title'</span>, <span class="hljs-string">'code-desc'</span>, <span class="hljs-string">'code-display'</span>);
    renderMatrixButtons(<span class="hljs-string">'boycott-buttons'</span>, boycottData, <span class="hljs-string">'boycott-tag'</span>, <span class="hljs-string">'boycott-title'</span>, <span class="hljs-string">'boycott-desc'</span>, <span class="hljs-string">'boycott-display'</span>);

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">loadTrack</span>(<span class="hljs-params">event, title, category, src</span>) </span>{
      <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'current-title'</span>).innerText = title;
      <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'current-category'</span>).innerText = category;
      <span class="hljs-keyword">const</span> audio = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'main-audio'</span>);
      audio.src = src;
      audio.play();

      <span class="hljs-built_in">document</span>.querySelectorAll(<span class="hljs-string">'.playlist-item'</span>).forEach(<span class="hljs-function"><span class="hljs-params">el</span> =&gt;</span> el.classList.remove(<span class="hljs-string">'active'</span>));
      event.currentTarget.classList.add(<span class="hljs-string">'active'</span>);
    }

    <span class="hljs-comment">// 12. 99-Card Wisdom Engine with Category Tags &amp; Search</span>
    <span class="hljs-keyword">const</span> chattyDeck = [
      { <span class="hljs-attr">id</span>: <span class="hljs-number">1</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Strategy"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Checkmate Perspective"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Look three steps ahead of the distraction. A calculated response always disarms a sudden reaction."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">2</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Stealth"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Shield of Stillness"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Quiet observation holds more power than immediate combat. Protect your center at all costs."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">3</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Strategy"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Sovereign Board"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Never play on a board where your opponent writes the rules. Establish your own grid and control the squares."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">4</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Stealth"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Curious Consultant Tactic"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Ask the question that makes them confront their own assumptions. Truth reveals itself when prompted calmly."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">5</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Stealth"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Stealth Discipline"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Internal strength doesn't need external applause. Move in silence and let the results speak."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">6</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Economics"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Specie Anchor"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Paper promises blow away with the wind. Sound money and land grants anchor true freedom."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">7</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Strategy"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Mastery of the Center"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Whoever commands the center commands the board. Protect your core principles from external dilution."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">8</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Stealth"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Strategic Non-Compliance"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Polite refusal to participate in degradation is the highest form of discipline and leverage."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">9</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Strategy"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Pillar Alignment"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Stand consciously between Boaz and Jachin. Balance intuitive vision with structured execution."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">10</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Strategy"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Silent Timing"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"The master does not strike when angry; the master moves when the board opens."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">11</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Stealth"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Boundary of Onyx"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"A boundary is not a wall of fear; it is an unshakeable standard of dignity."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">12</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Economics"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Economic Fast"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"When you fast from spending, you test your sovereignty. Self-reliance begins at home."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">13</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Lineage"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Unborrowed Authority"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Never seek permission to exist from systems designed to profit from your compliance."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">14</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Strategy"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Solar Vision"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Keep your sight elevated above emotional traps. Let clarity guide your footsteps."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">15</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Stealth"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Lunar Intuition"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Trust the quiet pulse within. Discernment senses the move before it is made."</span> },
