ntent-ng-c1708603972="" class="response-container-header ng-tns-c1708603972-229 ng-star-inserted"><div _ngcontent-ng-c1708603972="" class="response-container-header-controls ng-tns-c1708603972-229"><div _ngcontent-ng-c1708603972="" class="ng-tns-c1708603972-229 tts ng-trigger ng-trigger-singleResponseEnter ng-star-inserted" style=""><div _ngcontent-ng-c1708603972="" class="single-draft-response-container ng-tns-c1708603972-229"><!----></div></div><!----><!----></div><!----><!----><div _ngcontent-ng-c1708603972="" class="response-container-header-status ng-tns-c1708603972-229"><!----><div _ngcontent-ng-c1708603972="" class="response-container-header-processing-state ng-tns-c1708603972-229"></div></div></div><!----><div _ngcontent-ng-c1708603972="" class="presented-response-container ng-tns-c1708603972-229" jslog="283401;track:impression,attention" data-hveid="2"><!----><div _ngcontent-ng-c1708603972="" class="response-container-content ng-tns-c1708603972-229"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><div _ngcontent-ng-c2984337282="" highlighttoaskhost="" class="response-content ng-tns-c1708603972-229"><!----><thinking-overlay _ngcontent-ng-c2984337282="" _nghost-ng-c3439656023="" class="enable-luminous-fast-follows ng-star-inserted"><!----></thinking-overlay><!----><!----><!----><!----><!----><!----><!----><!----><div _ngcontent-ng-c2984337282="" class="model-response-label-announcer" aria-live="off" aria-busy="false"><!----><!----><h2 _ngcontent-ng-c2984337282="" class="cdk-visually-hidden screen-reader-model-response-label ng-star-inserted"> Gemini said </h2><!----><!----></div><!----><structured-content-container _ngcontent-ng-c2984337282="" class="model-response-text processing-state-visible ng-star-inserted" _nghost-ng-c912621556="" style="height: auto;"><div _ngcontent-ng-c912621556="" class="container"><message-content _ngcontent-ng-c912621556="" _nghost-ng-c3228108065="" id="message-content-id-r_7f1b1f68c1a3801d" class="ng-star-inserted"><div _ngcontent-ng-c3228108065="" inline-copy-host="" class="markdown markdown-main-panel md-content enable-luminous-fast-follows enable-updated-hr-color stronger tutor-markdown-rendering" id="model-response-message-contentr_7f1b1f68c1a3801d" aria-busy="false" aria-live="off" dir="ltr" style="--animation-duration: 400ms; --fade-animation-function: ease-out;"><p data-path-to-node="0">Let's organize your portal so you don't have to manually edit dozens of HTML lines by hand. We can structure your <code data-path-to-node="0" data-index-in-node="114">media/</code> folder into clear sub-categories, and I will write a simple <b data-path-to-node="0" data-index-in-node="181">Media Manifest List</b> directly into the JavaScript so you can easily list or paste all your song, video, and audio names in one clean spot.</p><p data-path-to-node="2"><b data-path-to-node="2" data-index-in-node="0">1. Recommended Folder Layout</b></p><p data-path-to-node="3">Inside your <code data-path-to-node="3" data-index-in-node="12">media/</code> folder, keep your folders organized like this:</p><response-element class="no-md" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><!----><code-block _nghost-ng-c362045847="" class="ng-tns-c362045847-238 enable-luminous-code-block ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c362045847="" class="code-block ng-tns-c362045847-238 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_7f1b1f68c1a3801d&quot;,&quot;c_054f4193c616e860&quot;,null,&quot;rc_f085beaf7e00258c&quot;,null,null,&quot;en&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwii6eHlvLmWAxUAAAAAHQAAAAAQ8Qc" style="display: block;"><!----><div _ngcontent-ng-c362045847="" class="formatted-code-block-internal-container ng-tns-c362045847-238"><div _ngcontent-ng-c362045847="" class="animated-opacity ng-tns-c362045847-238"><div _ngcontent-ng-c362045847="" class="code-block-decoration header-formatted gds-emphasized-body-m ng-tns-c362045847-238 ng-star-inserted" style=""><span _ngcontent-ng-c362045847="" class="ng-tns-c362045847-238">Plaintext</span><div _ngcontent-ng-c362045847="" class="buttons ng-tns-c362045847-238 ng-star-inserted"><gem-icon-button _ngcontent-ng-c362045847="" tabindex="-1" type="onSurface" size="small" fonticonname="arrow_circle_down" theme="lm" arialabel="Download code" gemtooltip="Download code" class="mat-mdc-tooltip-trigger download-button ng-tns-c362045847-238 gem-button gem-button-badge-size-small gem-button-size-small gem-button-type-on-surface lm-enabled ng-star-inserted" _nghost-ng-c653881194="" aria-describedby="cdk-describedby-message-ng-1-49" cdk-describedby-host="ng-1"><!----><!----><button _ngcontent-ng-c653881194="" maticonbutton="" matbadgeposition="after" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-badge mat-unthemed mat-badge-overlap mat-badge-above mat-badge-after mat-badge-small mat-badge-hidden ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" aria-label="Download code" jslog="305704;track:generic_click,impression"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><gem-icon _ngcontent-ng-c653881194="" _nghost-ng-c1939363340=""><mat-icon _ngcontent-ng-c1939363340="" role="img" class="mat-icon notranslate lm-icon-l lumi-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="arrow_circle_down" data-mat-icon-namespace="lumi-symbols" fonticon="arrow_circle_down"></mat-icon><!----><!----><!----></gem-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></gem-icon-button><!----><!----><!----><!----><!----><gem-icon-button _ngcontent-ng-c362045847="" tabindex="-1" type="onSurface" size="small" fonticonname="copy" theme="lm" arialabel="Copy code" gemtooltip="Copy code" data-test-id="gem-copy-button" class="mat-mdc-tooltip-trigger copy-button ng-tns-c362045847-238 gem-button gem-button-badge-size-small gem-button-size-small gem-button-type-on-surface lm-enabled ng-star-inserted" _nghost-ng-c653881194="" aria-describedby="cdk-describedby-message-ng-1-50" cdk-describedby-host="ng-1"><!----><!----><button _ngcontent-ng-c653881194="" maticonbutton="" matbadgeposition="after" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-badge mat-unthemed mat-badge-overlap mat-badge-above mat-badge-after mat-badge-small mat-badge-hidden ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" aria-label="Copy code" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_7f1b1f68c1a3801d&quot;,&quot;c_054f4193c616e860&quot;,null,&quot;rc_f085beaf7e00258c&quot;,null,null,&quot;en&quot;,null,1,null,null,1,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><gem-icon _ngcontent-ng-c653881194="" _nghost-ng-c1939363340=""><mat-icon _ngcontent-ng-c1939363340="" role="img" class="mat-icon notranslate lm-icon-l lumi-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="copy" data-mat-icon-namespace="lumi-symbols" fonticon="copy"></mat-icon><!----><!----><!----></gem-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></gem-icon-button><!----><!----><!----><!----></div><!----><!----></div><!----><pre _ngcontent-ng-c362045847="" class="ng-tns-c362045847-238"><code _ngcontent-ng-c362045847="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c362045847-238">media/
├── audio/
│   ├── ImanI Story/          &lt;-- (All ImanI Story audio tracks)
│   ├── The Mysteries/        &lt;-- (The 10 Mysteries of ImanI songs)
│   ├── Chatty Wisdom/        &lt;-- (Wisdom series songs)
│   └── Grand Awakening/      &lt;-- (Grand Awakening series tracks)
├── video/
│   ├── Music Videos/         &lt;-- (Official music videos)
│   ├── Cinema Vault/         &lt;-- (Documentaries &amp; lectures)
│   └── Archive/              &lt;-- (Live broadcast recordings)
└── images/                   &lt;-- (Logos, posters, still artwork)
</code></pre><!----></div></div></div><!----><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p data-path-to-node="6"><b data-path-to-node="6" data-index-in-node="0">2. How the Audio Playlist Array Works in JavaScript</b></p><p data-path-to-node="7" id="p-rc_f085beaf7e00258c-208"><span data-path-to-node="7,0">Instead of editing raw HTML elements for every track, we define an organized <b data-path-to-node="7,0" data-index-in-node="77">Playlist Array</b> inside the <code data-path-to-node="7,0" data-index-in-node="103">&lt;script&gt;</code> section at the bottom of <code data-path-to-node="7,0" data-index-in-node="137">index.html</code></span><span data-path-to-node="7,1"><span><response-element class="no-md" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><source-footnote _nghost-ng-c2282120608="" class="ng-star-inserted"><sup _ngcontent-ng-c2282120608="" class="superscript"><!----></sup></source-footnote><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element></span></span><span data-path-to-node="7,2">. You can add as many songs and series as you want by adding a single line for each:</span><sources-carousel-inline ng-version="0.0.0-PLACEHOLDER" _nghost-ng-c3062569485="">  <source-inline-chip _ngcontent-ng-c3062569485="" _nghost-ng-c1826364007="" class="ng-star-inserted"><div _ngcontent-ng-c1826364007="" class="source-inline-chip-container luminous-sources hide-from-message-actions ng-star-inserted"><button _ngcontent-ng-c1826364007="" cdkoverlayorigin="" class="button multiple-button ng-star-inserted" aria-label="View source details for citation from HTML: Index.html. Press Enter to open sources dialog." aria-expanded="false" aria-haspopup="dialog" jslog="262206;track:generic_click"><!----><div _ngcontent-ng-c1826364007="" dir="auto" class="source-label-container gds-body-s ng-star-inserted"><span _ngcontent-ng-c1826364007="" class="source-title" style="max-width: 20ch;">HTML</span><!----></div><!----><!----><!----><!----></button><!----><!----><!----><!----></div><!----><!----><!----><!----><!----></source-inline-chip><!----><!----><!----></sources-carousel-inline></p><response-element class="no-md" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><!----><code-block _nghost-ng-c362045847="" class="ng-tns-c362045847-239 enable-luminous-code-block ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c362045847="" class="code-block ng-tns-c362045847-239 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_7f1b1f68c1a3801d&quot;,&quot;c_054f4193c616e860&quot;,null,&quot;rc_f085beaf7e00258c&quot;,null,null,&quot;en&quot;,null,1,null,null,1,0]]" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwii6eHlvLmWAxUAAAAAHQAAAAAQ8wc" style="display: block;"><!----><div _ngcontent-ng-c362045847="" class="formatted-code-block-internal-container ng-tns-c3620458