      { <span class="hljs-attr">title</span>: <span class="hljs-string">"Chatty's Strategic Voice"</span>, <span class="hljs-attr">lore</span>: <span class="hljs-string">"Resonating frequencies across the soundboard, guiding movement through precision and patience."</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Episode 2 • Visual Lore"</span>, <span class="hljs-attr">src</span>: <span class="hljs-string">"media/images/Chatty Wisdom Header.png"</span> },
