    ];

    <span class="hljs-keyword">let</span> currentDeckTag = <span class="hljs-string">"ALL"</span>;
    <span class="hljs-keyword">let</span> activeWisdomPool = [...chattyDeck];
    <span class="hljs-keyword">let</span> lastDrawnIndex = -<span class="hljs-number">1</span>;

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">setDeckTagFilter</span>(<span class="hljs-params">tag, btn</span>) </span>{
      currentDeckTag = tag;
      <span class="hljs-built_in">document</span>.querySelectorAll(<span class="hljs-string">'.filter-tag-btn'</span>).forEach(<span class="hljs-function"><span class="hljs-params">b</span> =&gt;</span> b.classList.remove(<span class="hljs-string">'active'</span>));
      btn.classList.add(<span class="hljs-string">'active'</span>);
      filterWisdomDeck();
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">filterWisdomDeck</span>(<span class="hljs-params"></span>) </span>{
      <span class="hljs-keyword">const</span> search = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'wisdom-search'</span>).value.toLowerCase().trim();
      activeWisdomPool = chattyDeck.filter(<span class="hljs-function"><span class="hljs-params">card</span> =&gt;</span> {
        <span class="hljs-keyword">const</span> matchesTag = (currentDeckTag === <span class="hljs-string">"ALL"</span> || card.tag === currentDeckTag);
        <span class="hljs-keyword">const</span> matchesSearch = (!search || card.title.toLowerCase().includes(search) || card.quote.toLowerCase().includes(search));
        <span class="hljs-keyword">return</span> matchesTag &amp;&amp; matchesSearch;
      });
      drawWisdomCard();
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">drawWisdomCard</span>(<span class="hljs-params"></span>) </span>{
      <span class="hljs-keyword">if</span> (activeWisdomPool.length === <span class="hljs-number">0</span>) {
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'deck-title'</span>).innerText = <span class="hljs-string">"No Matching Wisdom Found"</span>;
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'deck-quote'</span>).innerText = <span class="hljs-string">"Adjust your search filter to draw from the 99 sovereign principles."</span>;
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'deck-number'</span>).innerText = <span class="hljs-string">"Card 0 of 0"</span>;
        <span class="hljs-keyword">return</span>;
      }
      <span class="hljs-keyword">const</span> container = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'wisdom-card-container'</span>);
      container.style.opacity = <span class="hljs-string">'0.5'</span>;
      <span class="hljs-built_in">setTimeout</span>(<span class="hljs-function">() =&gt;</span> {
        <span class="hljs-keyword">let</span> randomIndex;
        <span class="hljs-keyword">do</span> {
          randomIndex = <span class="hljs-built_in">Math</span>.floor(<span class="hljs-built_in">Math</span>.random() * activeWisdomPool.length);
        } <span class="hljs-keyword">while</span> (randomIndex === lastDrawnIndex &amp;&amp; activeWisdomPool.length &gt; <span class="hljs-number">1</span>);

        lastDrawnIndex = randomIndex;
        <span class="hljs-keyword">const</span> card = activeWisdomPool[randomIndex];
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'deck-title'</span>).innerText = card.title;
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'deck-quote'</span>).innerText = <span class="hljs-string">`"<span class="hljs-subst">${card.quote}</span>"`</span>;
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'deck-number'</span>).innerText = <span class="hljs-string">`Card #<span class="hljs-subst">${<span class="hljs-built_in">String</span>(card.id).padStart(<span class="hljs-number">2</span>, <span class="hljs-string">'0'</span>)}</span> of 99 [<span class="hljs-subst">${card.tag}</span>]`</span>;
        container.style.opacity = <span class="hljs-string">'1'</span>;
      }, <span class="hljs-number">150</span>);
    }

    <span class="hljs-built_in">window</span>.addEventListener(<span class="hljs-string">'DOMContentLoaded'</span>, <span class="hljs-function">() =&gt;</span> {
      renderAudioVault();
      renderStreamArchive();
      renderVideoVault(<span class="hljs-string">'music-video-gallery-container'</span>, myMusicVideosList);
      renderVideoVault(<span class="hljs-string">'cinema-gallery-container'</span>, myCinemaList);
      renderStillGallery(<span class="hljs-string">'still-gallery-container'</span>, myStillArtList);
      renderBoycottGallery();
      renderHolidayCalendar();

      renderMatrixButtons(<span class="hljs-string">'origins-buttons'</span>, originsData, <span class="hljs-string">'origin-tag'</span>, <span class="hljs-string">'origin-title'</span>, <span class="hljs-string">'origin-desc'</span>, <span class="hljs-string">'origin-display'</span>);
      renderMatrixButtons(<span class="hljs-string">'mysteries-buttons'</span>, mysteriesData, <span class="hljs-string">'mystery-tag'</span>, <span class="hljs-string">'mystery-title'</span>, <span class="hljs-string">'mystery-desc'</span>, <span class="hljs-string">'mystery-display'</span>);
      renderMatrixButtons(<span class="hljs-string">'activities-buttons'</span>, activitiesData, <span class="hljs-string">'activity-tag'</span>, <span class="hljs-string">'activity-title'</span>, <span class="hljs-string">'activity-desc'</span>, <span class="hljs-string">'activity-display'</span>);
      renderMatrixButtons(<span class="hljs-string">'restitution-buttons'</span>, restitutionData, <span class="hljs-string">'restitution-tag'</span>, <span class="hljs-string">'restitution-title'</span>, <span class="hljs-string">'restitution-desc'</span>, <span class="hljs-string">'restitution-display'</span>, <span class="hljs-function">(<span class="hljs-params">item</span>) =&gt;</span> {
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'restitution-gold'</span>).innerText = item.gold;
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'restitution-silver'</span>).innerText = item.silver;
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'restitution-rule'</span>).innerText = item.rule;
      });
      renderMatrixButtons(<span class="hljs-string">'codes-buttons'</span>, codesData, <span class="hljs-string">'code-tag'</span>, <span class="hljs-string">'code-title'</span>, <span class="hljs-string">'code-desc'</span>, <span class="hljs-string">'code-display'</span>);
      renderMatrixButtons(<span class="hljs-string">'boycott-buttons'</span>, boycottData, <span class="hljs-string">'boycott-tag'</span>, <span class="hljs-string">'boycott-title'</span>, <span class="hljs-string">'boycott-desc'</span>, <span class="hljs-string">'boycott-display'</span>);

      <span class="hljs-keyword">const</span> savedEmblem = <span class="hljs-built_in">localStorage</span>.getItem(<span class="hljs-string">'imani_header_emblem'</span>);
      <span class="hljs-keyword">if</span> (savedEmblem) {
        <span class="hljs-keyword">const</span> img = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'header-emblem-view'</span>);
        img.src = savedEmblem;
        img.style.display = <span class="hljs-string">'block'</span>;
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'emblem-picker-box'</span>).style.display = <span class="hljs-string">'none'</span>;
      }

      <span class="hljs-keyword">const</span> savedChatty = <span class="hljs-built_in">localStorage</span>.getItem(<span class="hljs-string">'chatty_wisdom_header'</span>);
      <span class="hljs-keyword">if</span> (savedChatty) {
        <span class="hljs-keyword">const</span> img = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'chatty-header-view'</span>);
        img.src = savedChatty;
        img.style.display = <span class="hljs-string">'block'</span>;
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'chatty-fallback-text'</span>).style.display = <span class="hljs-string">'none'</span>;
      }

      <span class="hljs-keyword">const</span> savedLandscape = <span class="hljs-built_in">localStorage</span>.getItem(<span class="hljs-string">'chatty_landscape_image'</span>);
      <span class="hljs-keyword">if</span> (savedLandscape) {
        <span class="hljs-keyword">const</span> img = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'chatty-landscape-view'</span>);
        img.src = savedLandscape;
        img.style.display = <span class="hljs-string">'block'</span>;
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'chatty-landscape-picker'</span>).style.display = <span class="hljs-string">'none'</span>;
      }

      <span class="hljs-keyword">const</span> standbyVideo = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'standby-motion-player'</span>);
      standbyVideo.play().catch(<span class="hljs-function">() =&gt;</span> {});

      <span class="hljs-built_in">setTimeout</span>(<span class="hljs-function">() =&gt;</span> {
        connectLiveStream();
      }, <span class="hljs-number">1000</span>);
    });
  </span><span class="hljs-tag">&lt;/<span class="hljs-name">script</span>&gt;</span>
<span class="hljs-tag">&lt;/<span class="hljs-name">body</span>&gt;</span>
<span class="hljs-tag">&lt;/<span class="hljs-name">html</span>&gt;</span>
</code></pre><!----></div></div></div><!----><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element></div></message-content><!----></div></structured-content-container><!----><!----><!----><div _ngcontent-ng-c2984337282="" class="response-footer gap complete"><!----><!----><!----><sources-list _ngcontent-ng-c2984337282="" class="sources-list ng-star-inserted"><!----></sources-list><!----><election-info-disclaimer _ngcontent-ng-c2984337282="" _nghost-ng-c3453717024="" class="ng-star-inserted" style="display: none;"><!----></election-info-disclaimer><finance-info-disclaimer _ngcontent-ng-c2984337282="" _nghost-ng-c2059050657="" class="ng-star-inserted" style="display: none;"><!----></finance-info-disclaimer><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div></div><!----><!----><!----><sensitive-memories-banner _ngcontent-ng-c2984337282="" _nghost-ng-c2551225198="" class="ng-star-inserted" style=""><!----></sensitive-memories-banner><!----><!----><!----><!----></div></div><div _ngcontent-ng-c1708603972="" class="response-container-footer ng-tns-c1708603972-254 ng-star-inserted"><!----><!----><!----><message-actions _ngcontent-ng-c2984337282="" footer="" class="hide-on-print ng-tns-c4169682743-257 ng-star-inserted hide-action-bar" _nghost-ng-c4169682743="" style=""><div _ngcontent-ng-c4169682743="" class="actions-container-v2 ng-tns-c4169682743-257"><div _ngcontent-ng-c4169682743="" class="b