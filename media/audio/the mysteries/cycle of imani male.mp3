    ];

    <span class="hljs-keyword">const</span> activitiesData = [
      { <span class="hljs-attr">id</span>: <span class="hljs-string">"01 &amp; 02"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Economics &amp; Education"</span>, <span class="hljs-attr">desc</span>: <span class="hljs-string">"&lt;strong&gt;Economics:&lt;/strong&gt; Practicing &lt;em&gt;Ujamaa&lt;/em&gt; (Cooperative Economics), managing our own resources, and building community-owned enterprises.&lt;br&gt;&lt;br&gt;&lt;strong&gt;Education:&lt;/strong&gt; Defining ourselves, writing our own narratives, and teaching sovereign history and culture."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-string">"03 &amp; 04"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Entertainment &amp; Labor"</span>, <span class="hljs-attr">desc</span>: <span class="hljs-string">"&lt;strong&gt;Entertainment:&lt;/strong&gt; Using music, cinema, and art to reflect soul power, dignity, and awakening.&lt;br&gt;&lt;br&gt;&lt;strong&gt;Labor:&lt;/strong&gt; Practicing &lt;em&gt;Ujima&lt;/em&gt; (Collective Work and Responsibility) so our labor builds our own foundation."</span> },
