          <span class="hljs-tag">&lt;<span class="hljs-name">div</span>&gt;</span><span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"rev-tag"</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"code-tag"</span>&gt;</span>Operational Code[cite: 1]<span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span><span class="hljs-tag">&lt;<span class="hljs-name">h3</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"rev-title"</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"code-title"</span>&gt;</span>Code of Silence[cite: 1]<span class="hljs-tag">&lt;/<span class="hljs-name">h3</span>&gt;</span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
