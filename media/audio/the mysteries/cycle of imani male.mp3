            <span class="hljs-tag">&lt;<span class="hljs-name">h3</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"rev-title"</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"origin-title"</span>&gt;</span>Sovereign Ontology[cite: 1]<span class="hljs-tag">&lt;/<span class="hljs-name">h3</span>&gt;</span>
