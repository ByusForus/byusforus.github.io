        <span class="hljs-tag">&lt;<span class="hljs-name">button</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"filter-tag-btn"</span> <span class="hljs-attr">onclick</span>=<span class="hljs-string">"setDeckTagFilter('Economics', this)"</span>&gt;</span>Economics<span class="hljs-tag">&lt;/<span class="hljs-name">button</span>&gt;</span>
        <span class="hljs-tag">&lt;<span class="hljs-name">button</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"filter-tag-btn"</span> <span class="hljs-attr">onclick</span>=<span class="hljs-string">"setDeckTagFilter('Stealth', this)"</span>&gt;</span>Stealth<span class="hljs-tag">&lt;/<span class="hljs-name">button</span>&gt;</span>
        <span class="hljs-tag">&lt;<span class="hljs-name">button</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"filter-tag-btn"</span> <span class="hljs-attr">onclick</span>=<span class="hljs-string">"setDeckTagFilter('Lineage', this)"</span>&gt;</span>Lineage<span class="hljs-tag">&lt;/<span class="hljs-name">button</span>&gt;</span>
