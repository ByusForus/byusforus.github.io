  <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"lightbox-modal"</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"lightbox-backdrop"</span> <span class="hljs-attr">onclick</span>=<span class="hljs-string">"closeMediaLightbox()"</span>&gt;</span>
    <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"lightbox-content"</span> <span class="hljs-attr">onclick</span>=<span class="hljs-string">"event.stopPropagation()"</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">button</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"lightbox-close-btn"</span> <span class="hljs-attr">onclick</span>=<span class="hljs-string">"closeMediaLightbox()"</span>&gt;</span><span class="hljs-symbol">&amp;times;</span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"lightbox-media-container"</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"lightbox-media-holder"</span>&gt;</span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"lightbox-caption-text"</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"lightbox-caption"</span>&gt;</span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
    <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
  <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>

  <span class="hljs-tag">&lt;<span class="hljs-name">script</span>&gt;</span><span class="javascript">
    <span class="hljs-comment">// =========================================================================</span>
    <span class="hljs-comment">// PERMANENT AUDIO MANIFEST (YOUR EXACT FILES)</span>
    <span class="hljs-comment">// =========================================================================</span>

    <span class="hljs-keyword">let</span> permanentAudioLibrary = [
      { 
        <span class="hljs-attr">title</span>: <span class="hljs-string">"10_mysteries_of_imani_jan_24_2026_1_18_30_pm2"</span>, 
        <span class="hljs-attr">category</span>: <span class="hljs-string">"The mysteries"</span>, 
        <span class="hljs-attr">src</span>: <span class="hljs-string">"media/audio/The mysteries/10_mysteries_of_imani_jan_24_2026_1_18_30_pm2.wav"</span>, 
        <span class="hljs-attr">duration</span>: <span class="hljs-string">"Song"</span> 
      },
      { 
        <span class="hljs-attr">title</span>: <span class="hljs-string">"Mysteries of ImanI"</span>, 
        <span class="hljs-attr">category</span>: <span class="hljs-string">"The mysteries"</span>, 
        <span class="hljs-attr">src</span>: <span class="hljs-string">"media/audio/The mysteries/Mysteries of ImanI.mp3"</span>, 
        <span class="hljs-attr">duration</span>: <span class="hljs-string">"Song"</span> 
      },
      { 
        <span class="hljs-attr">title</span>: <span class="hljs-string">"1 Alpha and Omega"</span>, 
        <span class="hljs-attr">category</span>: <span class="hljs-string">"The mysteries"</span>, 
        <span class="hljs-attr">src</span>: <span class="hljs-string">"media/audio/The mysteries/1 Alpha and Omega.mp3"</span>, 
        <span class="hljs-attr">duration</span>: <span class="hljs-string">"Song"</span> 
      },
      { 
        <span class="hljs-attr">title</span>: <span class="hljs-string">"3 Solomon Pillars"</span>, 
        <span class="hljs-attr">category</span>: <span class="hljs-string">"The mysteries"</span>, 
        <span class="hljs-attr">src</span>: <span class="hljs-string">"media/audio/The mysteries/3 Solomon Pillars.mp3"</span>, 
        <span class="hljs-attr">duration</span>: <span class="hljs-string">"Song"</span> 
      },
      { 
        <span class="hljs-attr">title</span>: <span class="hljs-string">"4 Solar and Lunar Power"</span>, 
        <span class="hljs-attr">category</span>: <span class="hljs-string">"The mysteries"</span>, 
        <span class="hljs-attr">src</span>: <span class="hljs-string">"media/audio/The mysteries/4 Solar and Lunar Power.mp3"</span>, 
        <span class="hljs-attr">duration</span>: <span class="hljs-string">"Song"</span> 
      },
      { 
        <span class="hljs-attr">title</span>: <span class="hljs-string">"5 I and I"</span>, 
        <span class="hljs-attr">category</span>: <span class="hljs-string">"The mysteries"</span>, 
        <span class="hljs-attr">src</span>: <span class="hljs-string">"media/audio/The mysteries/5 I and I.mp3"</span>, 
        <span class="hljs-attr">duration</span>: <span class="hljs-string">"Song"</span> 
      },
      { 
        <span class="hljs-attr">title</span>: <span class="hljs-string">"6 I M"</span>, 
        <span class="hljs-attr">category</span>: <span class="hljs-string">"The mysteries"</span>, 
        <span class="hljs-attr">src</span>: <span class="hljs-string">"media/audio/The mysteries/6 I M.mp3"</span>, 
        <span class="hljs-attr">duration</span>: <span class="hljs-string">"Song"</span> 
      },
      { 
        <span class="hljs-attr">title</span>: <span class="hljs-string">"7 I M ani"</span>, 
        <span class="hljs-attr">category</span>: <span class="hljs-string">"The mysteries"</span>, 
        <span class="hljs-attr">src</span>: <span class="hljs-string">"media/audio/The mysteries/7 I M ani.mp3"</span>, 
        <span class="hljs-attr">duration</span>: <span class="hljs-string">"Song"</span> 
      },
      { 
        <span class="hljs-attr">title</span>: <span class="hljs-string">"8 Initiation 101"</span>, 
        <span class="hljs-attr">category</span>: <span class="hljs-string">"The mysteries"</span>, 
        <span class="hljs-attr">src</span>: <span class="hljs-string">"media/audio/The mysteries/8 Initiation 101.mp3"</span>, 
        <span class="hljs-attr">duration</span>: <span class="hljs-string">"Song"</span> 
      }
    ];

    <span class="hljs-keyword">let</span> currentAudioCategory = <span class="hljs-string">"ALL"</span>;
    <span class="hljs-keyword">let</span> activeTrackIndex = <span class="hljs-number">0</span>;
    <span class="hljs-keyword">let</span> isContinuousPlay = <span class="hljs-literal">true</span>;
    <span class="hljs-keyword">let</span> isRandomPlay = <span class="hljs-literal">false</span>;

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">setAudioCategory</span>(<span class="hljs-params">category, btn</span>) </span>{
      currentAudioCategory = category;
      <span class="hljs-built_in">document</span>.querySelectorAll(<span class="hljs-string">'.audio-tab-btn'</span>).forEach(<span class="hljs-function"><span class="hljs-params">b</span> =&gt;</span> b.classList.remove(<span class="hljs-string">'active'</span>));
      btn.classList.add(<span class="hljs-string">'active'</span>);
      renderPlaylistItems();
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">getFilteredTrackPool</span>(<span class="hljs-params"></span>) </span>{
      <span class="hljs-keyword">return</span> permanentAudioLibrary.filter(<span class="hljs-function"><span class="hljs-params">t</span> =&gt;</span> currentAudioCategory === <span class="hljs-string">"ALL"</span> || t.category === currentAudioCategory);
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">renderPlaylistItems</span>(<span class="hljs-params"></span>) </span>{
      <span class="hljs-keyword">const</span> container = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'playlist-items-container'</span>);
      container.innerHTML = <span class="hljs-string">''</span>;

      <span class="hljs-keyword">const</span> filtered = getFilteredTrackPool();

      <span class="hljs-keyword">if</span> (filtered.length === <span class="hljs-number">0</span>) {
        container.innerHTML = <span class="hljs-string">`
          &lt;p style="color: var(--text-muted); font-size: 0.85rem; padding: 12px; text-align: center;"&gt;
            No tracks found in &lt;strong&gt;<span class="hljs-subst">${currentAudioCategory}</span>&lt;/strong&gt;.
          &lt;/p&gt;
        `</span>;
        <span class="hljs-keyword">return</span>;
      }

      filtered.forEach(<span class="hljs-function">(<span class="hljs-params">track, index</span>) =&gt;</span> {
        <span class="hljs-keyword">const</span> item = <span class="hljs-built_in">document</span>.createElement(<span class="hljs-string">'div'</span>);
        item.className = <span class="hljs-string">`playlist-item <span class="hljs-subst">${index === activeTrackIndex ? <span class="hljs-string">'active'</span> : <span class="hljs-string">''</span>}</span>`</span>;
        item.innerHTML = <span class="hljs-string">`
          &lt;div&gt;
            &lt;div class="track-title"&gt;<span class="hljs-subst">${track.title}</span>&lt;/div&gt;
            &lt;div style="font-size: 0.72rem; color: var(--text-muted);"&gt;<span class="hljs-subst">${track.category}</span>&lt;/div&gt;
          &lt;/div&gt;
          &lt;span class="track-duration"&gt;<span class="hljs-subst">${index === activeTrackIndex ? <span class="hljs-string">'▶ Playing'</span> : <span class="hljs-string">'▶ Play'</span>}</span>&lt;/span&gt;
        `</span>;
        item.onclick = <span class="hljs-function">() =&gt;</span> playTrackByIndex(index);
        container.appendChild(item);
      });
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">playTrackByIndex</span>(<span class="hljs-params">index</span>) </span>{
      <span class="hljs-keyword">const</span> filtered = getFilteredTrackPool();
      <span class="hljs-keyword">if</span> (index &lt; <span class="hljs-number">0</span> || index &gt;= filtered.length) <span class="hljs-keyword">return</span>;

      activeTrackIndex = index;
      <span class="hljs-keyword">const</span> track = filtered[index];

      <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'current-title'</span>).innerText = track.title;
      <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'current-category'</span>).innerText = track.category;
      
      <span class="hljs-keyword">const</span> audio = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'main-audio'</span>);
      audio.src = track.src;
      audio.play().catch(<span class="hljs-function">() =&gt;</span> {});

      renderPlaylistItems();
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">toggleContinuousPlay</span>(<span class="hljs-params"></span>) </span>{
      isContinuousPlay = !isContinuousPlay;
      <span class="hljs-keyword">const</span> btn = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'btn-continuous'</span>);
      <span class="hljs-keyword">const</span> lbl = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'lbl-continuous'</span>);
      
      <span class="hljs-keyword">if</span> (isContinuousPlay) {
        btn.classList.add(<span class="hljs-string">'active'</span>);
        lbl.innerText = <span class="hljs-string">"Continuous: ON"</span>;
      } <span class="hljs-keyword">else</span> {
        btn.classList.remove(<span class="hljs-string">'active'</span>);
        lbl.innerText = <span class="hljs-string">"Continuous: OFF"</span>;
      }
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">toggleRandomPlay</span>(<span class="hljs-params"></span>) </span>{
      isRandomPlay = !isRandomPlay;
      <span class="hljs-keyword">const</span> btn = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'btn-random'</span>);
      <span class="hljs-keyword">const</span> lbl = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'lbl-random'</span>);
      
      <span class="hljs-keyword">if</span> (isRandomPlay) {
        btn.classList.add(<span class="hljs-string">'active'</span>, <span class="hljs-string">'shuffle'</span>);
        lbl.innerText = <span class="hljs-string">"Random: ON"</span>;
      } <span class="hljs-keyword">else</span> {
        btn.classList.remove(<span class="hljs-string">'active'</span>, <span class="hljs-string">'shuffle'</span>);
        lbl.innerText = <span class="hljs-string">"Random: OFF"</span>;
      }
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">playNextTrack</span>(<span class="hljs-params"></span>) </span>{
      <span class="hljs-keyword">const</span> filtered = getFilteredTrackPool();
      <span class="hljs-keyword">if</span> (filtered.length &lt;= <span class="hljs-number">1</span>) {
        <span class="hljs-keyword">const</span> audio = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'main-audio'</span>);
        audio.currentTime = <span class="hljs-number">0</span>;
        audio.play().catch(<span class="hljs-function">() =&gt;</span> {});
        <span class="hljs-keyword">return</span>;
      }

      <span class="hljs-keyword">if</span> (isRandomPlay) {
        <span class="hljs-keyword">let</span> randomIndex;
        <span class="hljs-keyword">do</span> {
          randomIndex = <span class="hljs-built_in">Math</span>.floor(<span class="hljs-built_in">Math</span>.random() * filtered.length);
        } <span class="hljs-keyword">while</span> (randomIndex === activeTrackIndex &amp;&amp; filtered.length &gt; <span class="hljs-number">1</span>);
        playTrackByIndex(randomIndex);
      } <span class="hljs-keyword">else</span> {
        <span class="hljs-keyword">let</span> nextIndex = activeTrackIndex + <span class="hljs-number">1</span>;
        <span class="hljs-keyword">if</span> (nextIndex &gt;= filtered.length) {
          nextIndex = <span class="hljs-number">0</span>;
        }
        playTrackByIndex(nextIndex);
      }
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">playPreviousTrack</span>(<span class="hljs-params"></span>) </span>{
      <span class="hljs-keyword">const</span> filtered = getFilteredTrackPool();
      <span class="hljs-keyword">if</span> (filtered.length &lt;= <span class="hljs-number">1</span>) <span class="hljs-keyword">return</span>;

      <span class="hljs-keyword">let</span> prevIndex = activeTrackIndex - <span class="hljs-number">1</span>;
      <span class="hljs-keyword">if</span> (prevIndex &lt; <span class="hljs-number">0</span>) {
        prevIndex = filtered.length - <span class="hljs-number">1</span>;
      }
      playTrackByIndex(prevIndex);
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">handleTrackEnded</span>(<span class="hljs-params"></span>) </span>{
      <span class="hljs-keyword">if</span> (isContinuousPlay || isRandomPlay) {
        playNextTrack();
      }
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">handleUserAudioUpload</span>(<span class="hljs-params">event</span>) </span>{
      <span class="hljs-keyword">const</span> files = <span class="hljs-built_in">Array</span>.from(event.target.files);
      <span class="hljs-keyword">if</span> (!files.length) <span class="hljs-keyword">return</span>;

      files.forEach(<span class="hljs-function"><span class="hljs-params">file</span> =&gt;</span> {
        <span class="hljs-keyword">let</span> cleanName = file.name.replace(<span class="hljs-regexp">/\.[^/.]+$/</span>, <span class="hljs-string">""</span>);
        <span class="hljs-keyword">let</span> detectedCategory = <span class="hljs-string">"The mysteries"</span>;

        <span class="hljs-keyword">let</span> lower = (file.webkitRelativePath || file.name).toLowerCase();
        <span class="hljs-keyword">if</span> (lower.includes(<span class="hljs-string">"agreement"</span>) || lower.includes(<span class="hljs-string">"agreements"</span>)) {
          detectedCategory = <span class="hljs-string">"Audio Agreements"</span>;
        } <span class="hljs-keyword">else</span> <span class="hljs-keyword">if</span> (lower.includes(<span class="hljs-string">"story"</span>) || lower.includes(<span class="hljs-string">"imani story"</span>)) {
          detectedCategory = <span class="hljs-string">"ImanI story"</span>;
        }

        permanentAudioLibrary.push({
          <span class="hljs-attr">title</span>: cleanName,
          <span class="hljs-attr">category</span>: detectedCategory,
          <span class="hljs-attr">src</span>: URL.createObjectURL(file),
          <span class="hljs-attr">duration</span>: <span class="hljs-string">"Audio File"</span>
        });
      });

      renderPlaylistItems();
    }

