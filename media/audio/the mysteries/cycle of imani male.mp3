  <span class="hljs-tag">&lt;<span class="hljs-name">script</span>&gt;</span><span class="javascript">
    <span class="hljs-comment">// =========================================================================</span>
    <span class="hljs-comment">// MASTER MEDIA LIBRARIES (TAILORED TO YOUR 3 AUDIO FOLDERS)</span>
    <span class="hljs-comment">// =========================================================================</span>

    <span class="hljs-comment">// 1. Audio Library (Organized into: ImanI story, The mysteries, Audio Agreements)</span>
    <span class="hljs-keyword">const</span> myAudioLibrary = [
      <span class="hljs-comment">// Folder 1: ImanI story</span>
      { <span class="hljs-attr">title</span>: <span class="hljs-string">"The Sovereign Genesis"</span>, <span class="hljs-attr">category</span>: <span class="hljs-string">"ImanI story"</span>, <span class="hljs-attr">src</span>: <span class="hljs-string">"media/audio/ImanI story/sovereign_genesis.mp3"</span>, <span class="hljs-attr">duration</span>: <span class="hljs-string">"4:32"</span> },
      { <span class="hljs-attr">title</span>: <span class="hljs-string">"Awakening from Condition to Character"</span>, <span class="hljs-attr">category</span>: <span class="hljs-string">"ImanI story"</span>, <span class="hljs-attr">src</span>: <span class="hljs-string">"media/audio/ImanI story/condition_to_character.mp3"</span>, <span class="hljs-attr">duration</span>: <span class="hljs-string">"5:14"</span> },
      { <span class="hljs-attr">title</span>: <span class="hljs-string">"The Lineage of Faith"</span>, <span class="hljs-attr">category</span>: <span class="hljs-string">"ImanI story"</span>, <span class="hljs-attr">src</span>: <span class="hljs-string">"media/audio/ImanI story/lineage_of_faith.mp3"</span>, <span class="hljs-attr">duration</span>: <span class="hljs-string">"4:48"</span> },

      <span class="hljs-comment">// Folder 2: The mysteries (10 Mysteries of ImanI)</span>
      { <span class="hljs-attr">title</span>: <span class="hljs-string">"Mystery 01 - Alpha &amp; Omega"</span>, <span class="hljs-attr">category</span>: <span class="hljs-string">"The mysteries"</span>, <span class="hljs-attr">src</span>: <span class="hljs-string">"media/audio/The mysteries/mystery_01.mp3"</span>, <span class="hljs-attr">duration</span>: <span class="hljs-string">"3:45"</span> },
      { <span class="hljs-attr">title</span>: <span class="hljs-string">"Mystery 02 - Divine Soul"</span>, <span class="hljs-attr">category</span>: <span class="hljs-string">"The mysteries"</span>, <span class="hljs-attr">src</span>: <span class="hljs-string">"media/audio/The mysteries/mystery_02.mp3"</span>, <span class="hljs-attr">duration</span>: <span class="hljs-string">"4:02"</span> },
