      { <span class="hljs-attr">id</span>: <span class="hljs-string">"9"</span>, <span class="hljs-attr">btnTitle</span>: <span class="hljs-string">"9. Narrative"</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Priority Pillar 9"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"9. Narrative"</span>, <span class="hljs-attr">desc</span>: <span class="hljs-string">"Lineage Archives &amp; Heritage Media"</span>, <span class="hljs-attr">gold</span>: <span class="hljs-string">"10 oz Bullion"</span>, <span class="hljs-attr">silver</span>: <span class="hljs-string">"825 oz Coinage"</span>, <span class="hljs-attr">rule</span>: <span class="hljs-string">"Lineage Controlled"</span> }
