      { <span class="hljs-attr">id</span>: <span class="hljs-string">"3"</span>, <span class="hljs-attr">btnTitle</span>: <span class="hljs-string">"3. Housing"</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Priority Pillar 3"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"3. Housing"</span>, <span class="hljs-attr">desc</span>: <span class="hljs-string">"Restitution for Redlining/Land Theft"</span>, <span class="hljs-attr">gold</span>: <span class="hljs-string">"80 oz Bullion"</span>, <span class="hljs-attr">silver</span>: <span class="hljs-string">"6,600 oz Coinage"</span>, <span class="hljs-attr">rule</span>: <span class="hljs-string">"Equity Standalone"</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-string">"4"</span>, <span class="hljs-attr">btnTitle</span>: <span class="hljs-string">"4. Food"</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Priority Pillar 4"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"4. Food"</span>, <span class="hljs-attr">desc</span>: <span class="hljs-string">"Permanent Sovereign Food Security"</span>, <span class="hljs-attr">gold</span>: <span class="hljs-string">"20 oz Bullion"</span>, <span class="hljs-attr">silver</span>: <span class="hljs-string">"1,650 oz Coinage"</span>, <span class="hljs-attr">rule</span>: <span class="hljs-string">"Independent Asset"</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-string">"5"</span>, <span class="hljs-attr">btnTitle</span>: <span class="hljs-string">"5. Education"</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Priority Pillar 5"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"5. Education"</span>, <span class="hljs-attr">desc</span>: <span class="hljs-string">"Tuition Coverage &amp; Institutional Funding"</span>, <span class="hljs-attr">gold</span>: <span class="hljs-string">"40 oz Bullion"</span>, <span class="hljs-attr">silver</span>: <span class="hljs-string">"3,300 oz Coinage"</span>, <span class="hljs-attr">rule</span>: <span class="hljs-string">"Debt Elimination"</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-string">"6"</span>, <span class="hljs-attr">btnTitle</span>: <span class="hljs-string">"6. Land &amp; Wealth"</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Priority Pillar 6"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"6. Land &amp; Wealth"</span>, <span class="hljs-attr">desc</span>: <span class="hljs-string">"Protected Capital &amp; Land Grants"</span>, <span class="hljs-attr">gold</span>: <span class="hljs-string">"60 oz Bullion"</span>, <span class="hljs-attr">silver</span>: <span class="hljs-string">"5,000 oz Coinage"</span>, <span class="hljs-attr">rule</span>: <span class="hljs-string">"Asset Creation"</span> },
