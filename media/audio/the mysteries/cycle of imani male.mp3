            <span class="hljs-tag">&lt;<span class="hljs-name">p</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"gallery-card-lore"</span>&gt;</span>Cinematic presentation detailing the origin of the sovereign name and the ten mysteries.<span class="hljs-tag">&lt;/<span class="hljs-name">p</span>&gt;</span>
            <span class="hljs-tag">&lt;<span class="hljs-name">span</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"gallery-card-tag"</span>&gt;</span>Chapter 1 • 4K Motion<span class="hljs-tag">&lt;/<span class="hljs-name">span</span>&gt;</span>
