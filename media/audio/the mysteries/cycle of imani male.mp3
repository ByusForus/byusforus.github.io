star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="copy" data-mat-icon-namespace="lumi-symbols" fonticon="copy"></mat-icon><!----><!----><!----></gem-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></gem-icon-button><!----><!----><!----><!----></div><!----><!----></div><!----><pre _ngcontent-ng-c362045847="" class="ng-tns-c362045847-59"><code _ngcontent-ng-c362045847="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c362045847-59"><span class="hljs-meta">&lt;!DOCTYPE <span class="hljs-meta-keyword">html</span>&gt;</span>
<span class="hljs-tag">&lt;<span class="hljs-name">html</span> <span class="hljs-attr">lang</span>=<span class="hljs-string">"en"</span>&gt;</span>
<span class="hljs-tag">&lt;<span class="hljs-name">head</span>&gt;</span>
  <span class="hljs-tag">&lt;<span class="hljs-name">meta</span> <span class="hljs-attr">charset</span>=<span class="hljs-string">"UTF-8"</span>&gt;</span>
  <span class="hljs-tag">&lt;<span class="hljs-name">meta</span> <span class="hljs-attr">name</span>=<span class="hljs-string">"viewport"</span> <span class="hljs-attr">content</span>=<span class="hljs-string">"width=device-width, initial-scale=1.0"</span>&gt;</span>
  <span class="hljs-tag">&lt;<span class="hljs-name">title</span>&gt;</span>ImanI — Live Stage, Cultural Vault &amp; Doctrine<span class="hljs-tag">&lt;/<span class="hljs-name">title</span>&gt;</span>
  <span class="hljs-comment">&lt;!-- Direct HLS Live Streaming Engine --&gt;</span>
  <span class="hljs-tag">&lt;<span class="hljs-name">script</span> <span class="hljs-attr">src</span>=<span class="hljs-string">"https://cdn.jsdelivr.net/npm/hls.js@latest"</span>&gt;</span><span class="hljs-tag">&lt;/<span class="hljs-name">script</span>&gt;</span>
  <span class="hljs-tag">&lt;<span class="hljs-name">style</span>&gt;</span><span class="css">
    <span class="hljs-selector-pseudo">:root</span> {
      --onyx-deep: <span class="hljs-number">#000000</span>;
      --onyx-surface: <span class="hljs-built_in">rgba</span>(<span class="hljs-number">14</span>, <span class="hljs-number">14</span>, <span class="hljs-number">14</span>, <span class="hljs-number">0.94</span>);
      --onyx-card: <span class="hljs-built_in">rgba</span>(<span class="hljs-number">22</span>, <span class="hljs-number">22</span>, <span class="hljs-number">22</span>, <span class="hljs-number">0.92</span>);
      --onyx-<span class="hljs-attribute">border</span>: <span class="hljs-number">#222624</span>;
      --emerald-accent: <span class="hljs-number">#00D06C</span>;
      --emerald-glow: <span class="hljs-built_in">rgba</span>(<span class="hljs-number">0</span>, <span class="hljs-number">208</span>, <span class="hljs-number">108</span>, <span class="hljs-number">0.25</span>);
      --gold-accent: <span class="hljs-number">#FFD15C</span>;
      --gold-glow: <span class="hljs-built_in">rgba</span>(<span class="hljs-number">255</span>, <span class="hljs-number">209</span>, <span class="hljs-number">92</span>, <span class="hljs-number">0.2</span>);
      --purple-accent: <span class="hljs-number">#A855F7</span>;
      --purple-glow: <span class="hljs-built_in">rgba</span>(<span class="hljs-number">168</span>, <span class="hljs-number">85</span>, <span class="hljs-number">247</span>, <span class="hljs-number">0.3</span>);
      --text-<span class="hljs-selector-tag">main</span>: <span class="hljs-number">#F4F6F5</span>;
      --text-muted: <span class="hljs-number">#9BA8A1</span>;
      --radius-sm: <span class="hljs-number">8px</span>;
      --radius-md: <span class="hljs-number">14px</span>;
      --<span class="hljs-attribute">font</span>-sans: -apple-system, BlinkMacSystemFont, <span class="hljs-string">"Segoe UI"</span>, Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    }

    * {
      <span class="hljs-attribute">box-sizing</span>: border-box;
      <span class="hljs-attribute">margin</span>: <span class="hljs-number">0</span>;
      <span class="hljs-attribute">padding</span>: <span class="hljs-number">0</span>;
    }

    <span class="hljs-selector-tag">body</span> {
      <span class="hljs-attribute">color</span>: <span class="hljs-built_in">var</span>(--text-main);
      <span class="hljs-attribute">font-family</span>: <span class="hljs-built_in">var</span>(--font-sans);
      <span class="hljs-attribute">line-height</span>: <span class="hljs-number">1.6</span>;
      <span class="hljs-attribute">padding-bottom</span>: <span class="hljs-number">60px</span>;
      <span class="hljs-attribute">min-height</span>: <span class="hljs-number">100vh</span>;
      <span class="hljs-attribute">background</span>: <span class="hljs-built_in">linear-gradient</span>(
        <span class="hljs-number">90deg</span>,
        <span class="hljs-built_in">rgba</span>(<span class="hljs-number">0</span>, <span class="hljs-number">75</span>, <span class="hljs-number">40</span>, <span class="hljs-number">0.95</span>) <span class="hljs-number">0%</span>,
        <span class="hljs-built_in">rgba</span>(<span class="hljs-number">0</span>, <span class="hljs-number">110</span>, <span class="hljs-number">58</span>, <span class="hljs-number">0.8</span>) <span class="hljs-number">30%</span>,
        <span class="hljs-number">#000000</span> <span class="hljs-number">33.33%</span>,
        <span class="hljs-number">#000000</span> <span class="hljs-number">66.66%</span>,
        <span class="hljs-built_in">rgba</span>(<span class="hljs-number">145</span>, <span class="hljs-number">105</span>, <span class="hljs-number">15</span>, <span class="hljs-number">0.8</span>) <span class="hljs-number">70%</span>,
        <span class="hljs-built_in">rgba</span>(<span class="hljs-number">100</span>, <span class="hljs-number">72</span>, <span class="hljs-number">10</span>, <span class="hljs-number">0.95</span>) <span class="hljs-number">100%</span>
      );
      <span class="hljs-attribute">background-attachment</span>: fixed;
      <span class="hljs-attribute">background-size</span>: cover;
    }

    <span class="hljs-comment">/* Economic Fast Alert Banner */</span>
    <span class="hljs-selector-class">.pause-banner</span> {
      <span class="hljs-attribute">background</span>: <span class="hljs-number">#000000</span>;
      <span class="hljs-attribute">border-bottom</span>: <span class="hljs-number">1px</span> solid <span class="hljs-built_in">var</span>(--gold-accent);
      <span class="hljs-attribute">padding</span>: <span class="hljs-number">12px</span> <span class="hljs-number">20px</span>;
      <span class="hljs-attribute">position</span>: relative;
      <span class="hljs-attribute">z-index</span>: <span class="hljs-number">101</span>;
      <span class="hljs-attribute">box-shadow</span>: <span class="hljs-number">0</span> <span class="hljs-number">2px</span> <span class="hljs-number">15px</span> <span class="hljs-built_in">var</span>(--gold-glow);
    }

    <span class="hljs-selector-class">.pause-content</span> {
      <span class="hljs-attribute">max-width</span>: <span class="hljs-number">1200px</span>;
      <span class="hljs-attribute">margin</span>: <span class="hljs-number">0</span> auto;
      <span class="hljs-attribute">display</span>: flex;
      <span class="hljs-attribute">flex-wrap</span>: wrap;
      <span class="hljs-attribute">justify-content</span>: space-between;
      <span class="hljs-attribute">align-items</span>: center;
      gap: <span class="hljs-number">16px</span>;
    }

    <span class="hljs-selector-class">.pause-text-wrap</span> {
      <span class="hljs-attribute">display</span>: flex;
      <span class="hljs-attribute">align-items</span>: center;
      gap: <span class="hljs-number">12px</span>;
    }

    <span class="hljs-selector-class">.pause-indicator</span> {
      <span class="hljs-attribute">width</span>: <span class="hljs-number">10px</span>;
      <span class="hljs-attribute">height</span>: <span class="hljs-number">10px</span>;
      <span class="hljs-attribute">border-radius</span>: <span class="hljs-number">50%</span>;
      <span class="hljs-attribute">background</span>: <span class="hljs-built_in">var</span>(--gold-accent);
      <span class="hljs-attribute">box-shadow</span>: <span class="hljs-number">0</span> <span class="hljs-number">0</span> <span class="hljs-number">8px</span> <span class="hljs-built_in">var</span>(--gold-accent);
      <span class="hljs-attribute">animation</span>: pulse <span class="hljs-number">2s</span> infinite ease-in-out;
    }

    <span class="hljs-keyword">@keyframes</span> pulse {
      <span class="hljs-number">0%</span>, <span class="hljs-number">100%</span> { <span class="hljs-attribute">opacity</span>: <span class="hljs-number">1</span>; <span class="hljs-attribute">transform</span>: <span class="hljs-built_in">scale</span>(<span class="hljs-number">1</span>); }
      <span class="hljs-number">50%</span> { <span class="hljs-attribute">opacity</span>: <span class="hljs-number">0.4</span>; <span class="hljs-attribute">transform</span>: <span class="hljs-built_in">scale</span>(<span class="hljs-number">0.85</span>); }
    }

    <span class="hljs-selector-class">.pause-title</span> {
      <span class="hljs-attribute">font-weight</span>: <span class="hljs-number">700</span>;
      <span class="hljs-attribute">font-size</span>: <span class="hljs-number">0.95rem</span>;
      <span class="hljs-attribute">color</span>: <span class="hljs-built_in">var</span>(--gold-accent);
      <span class="hljs-attribute">letter-spacing</span>: <span class="hljs-number">0.03em</span>;
    }

    <span class="hljs-selector-class">.pause-subtitle</span> {
      <span class="hljs-attribute">font-size</span>: <span class="hljs-number">0.85rem</span>;
      <span class="hljs-attribute">color</span>: <span class="hljs-built_in">var</span>(--text-muted);
    }

    <span class="hljs-selector-class">.countdown-display</span> {
      <span class="hljs-attribute">display</span>: flex;
      <span class="hljs-attribute">align-items</span>: center;
      gap: <span class="hljs-number">8px</span>;
    }

    <span class="hljs-selector-class">.countdown-unit</span> {
      <span class="hljs-attribute">background</span>: <span class="hljs-built_in">var</span>(--onyx-surface);
      <span class="hljs-attribute">border</span>: <span class="hljs-number">1px</span> solid <span class="hljs-built_in">var</span>(--onyx-border);
      <span class="hljs-attribute">border-radius</span>: <span class="hljs-number">6px</span>;
      <span class="hljs-attribute">padding</span>: <span class="hljs-number">4px</span> <span class="hljs-number">8px</span>;
      <span class="hljs-attribute">text-align</span>: center;
      <span class="hljs-attribute">min-width</span>: <span class="hljs-number">48px</span>;
    }

    <span class="hljs-selector-class">.countdown-val</span> {
      <span class="hljs-attribute">font-weight</span>: <span class="hljs-number">800</span>;
      <span class="hljs-attribute">font-size</span>: <span class="hljs-number">1rem</span>;
      <span class="hljs-attribute">color</span>: <span class="hljs-built_in">var</span>(--emerald-accent);
      <span class="hljs-attribute">line-height</span>: <span class="hljs-number">1.1</span>;
    }

    <span class="hljs-selector-class">.countdown-lbl</span> {
      <span class="hljs-attribute">font-size</span>: <span class="hljs-number">0.65rem</span>;
      <span class="hljs-attribute">text-transform</span>: uppercase;
      <span class="hljs-attribute">color</span>: <span class="hljs-built_in">var</span>(--text-muted);
      <span class="hljs-attribute">letter-spacing</span>: <span class="hljs-number">0.05em</span>;
    }

    <span class="hljs-comment">/* Header */</span>
    <span class="hljs-selector-tag">header</span> {
      <span class="hljs-attribute">border-bottom</span>: <span class="hljs-number">1px</span> solid <span class="hljs-built_in">var</span>(--onyx-border);
      <span class="hljs-attribute">background</span>: <span class="hljs-built_in">rgba</span>(<span class="hljs-number">0</span>, <span class="hljs-number">0</span>, <span class="hljs-number">0</span>, <span class="hljs-number">0.98</span>);
      backdrop-<span class="hljs-attribute">filter</span>: <span class="hljs-built_in">blur</span>(<span class="hljs-number">10px</span>);
      <span class="hljs-attribute">position</span>: sticky;
      <span class="hljs-attribute">top</span>: <span class="hljs-number">0</span>;
      <span class="hljs-attribute">z-index</span>: <span class="hljs-number">100</span>;
      <span class="hljs-attribute">width</span>: <span class="hljs-number">100%</span>;
    }

    <span class="hljs-selector-class">.header-layout</span> {
