  { <span class="hljs-attr">title</span>: <span class="hljs-string">"ImanI Story - Part 2"</span>, <span class="hljs-attr">category</span>: <span class="hljs-string">"ImanI Story"</span>, <span class="hljs-attr">src</span>: <span class="hljs-string">"media/audio/ImanI Story/part2.mp3"</span>, <span class="hljs-attr">duration</span>: <span class="hljs-string">"5:10"</span> },

