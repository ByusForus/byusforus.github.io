          <span class="hljs-tag">&lt;<span class="hljs-name">button</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"btn-audio-narrate"</span> <span class="hljs-attr">onclick</span>=<span class="hljs-string">"narrateText('mystery-title', 'mystery-desc')"</span>&gt;</span>🔊 Listen<span class="hljs-tag">&lt;/<span class="hljs-name">button</span>&gt;</span>
