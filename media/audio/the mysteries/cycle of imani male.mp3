      <span class="hljs-attribute">font-weight</span>: <span class="hljs-number">400</span>;
      <span class="hljs-attribute">max-width</span>: <span class="hljs-number">680px</span>;
      <span class="hljs-attribute">color</span>: <span class="hljs-built_in">var</span>(--text-main);
      <span class="hljs-attribute">line-height</span>: <span class="hljs-number">1.7</span>;
    }

    <span class="hljs-selector-class">.card-number-label</span> {
      <span class="hljs-attribute">font-size</span>: <span class="hljs-number">0.8rem</span>;
      <span class="hljs-attribute">color</span>: <span class="hljs-built_in">var</span>(--text-muted);
      <span class="hljs-attribute">margin-top</span>: <span class="hljs-number">10px</span>;
      <span class="hljs-attribute">font-style</span>: italic;
    }

    <span class="hljs-selector-class">.btn-draw-card</span> {
      <span class="hljs-attribute">background</span>: <span class="hljs-built_in">var</span>(--gold-accent);
      <span class="hljs-attribute">color</span>: <span class="hljs-built_in">var</span>(--onyx-deep);
      <span class="hljs-attribute">border</span>: none;
      <span class="hljs-attribute">padding</span>: <span class="hljs-number">10px</span> <span class="hljs-number">24px</span>;
      <span class="hljs-attribute">border-radius</span>: <span class="hljs-built_in">var</span>(--radius-sm);
      <span class="hljs-attribute">font-weight</span>: <span class="hljs-number">700</span>;
