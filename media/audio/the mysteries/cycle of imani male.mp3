48844,null,true,null,null,null,\"OFpCnd\"],[45784772,null,false,null,null,null,\"uAKIW\"],[45661179,null,true,null,null,null,\"v7fyTe\"],[45694234,null,true,null,null,null,\"BInird\"],[45772636,null,true,null,null,null,\"jkGkae\"],[45766070,null,false,null,null,null,\"U4i5Zd\"],[45719589,null,false,null,null,null,\"bmEZhd\"],[45745956,null,false,null,null,null,\"M0rVQd\"],[45766621,null,true,null,null,null,\"SYa5Gc\"],[45790780,null,false,null,null,null,\"VgkAlb\"],[45754555,null,true,null,null,null,\"vd3Oxe\"],[45742222,null,null,null,\"Create a comic with the title: Getting started with Nano Banana Pro 🍌. Panel 1: A mobile interface on Gemini, rendered in a poetic watercolor-ink style with fine ink outlines and soft, bleeding washes. The interface is friendly and a hand painted with expressive brushwork taps a prominent button labeled “🍌 Create image”. Above the button it should say “Choose your Model” then below there should be a checkbox that says “Thinking with 3 Pro”  Muted greys and blues dominate the background. The button has a vivid yellow accent. “ Select the Thinking with 3 Pro model” and tap \\\"Create image\\\" to begin. Panel 2: A cheerful person is depicted adding their selfie from the phone’s camera. The user\u0027s face is drawn with soft outlines and warm pastel colors, while the phone and UI maintain the delicate water-ink aesthetic. Visible paper grain adds to the texture. Panel 3: The person thinks about what to create. In the background, different options are visualized to show what they’re thinking, including — them as a plushie, them with a mohawk hairstyle, and a figurine. These options are clearly rendered behind the person in the same style as the rest of the comic. Panel 4: The person is shown adding a style prompt, with a speech bubble saying “Transform me into a watercolor painting”. The text is integrated into the panel\u0027s watercolor-ink look, and the interaction feels natural and intuitive. Panel 5: The person is seen editing the image by simply typing into Gemini. The scene captures the ease of this interaction, with the final edited image, now in a watercolor style, appearing on the screen. The overall tone is friendly, instructional, and inspiring. It feels like a mini tutorial comic, all conveyed through the specified delicate water-ink illustration style. Make the aspect ratio 16:9.\",null,\"wN9i0b\"],[45742219,null,null,null,\"🍌 Nano Banana Pro is now on Gemini 3 Pro. \",null,\"aGv0md\"],[45760731,null,true,null,null,null,\"KpifRc\"],[45786117,null,false,null,null,null,\"w1XIte\"],[45753284,null,true,null,null,null,\"yTBDtf\"],[45428795,null,false,null,null,null,\"C2P4R\"],[45685029,null,true,null,null,null,\"aAR2Wc\"],[45670623,null,true,null,null,null,\"cTWF7\"],[45623848,null,null,null,null,null,\"MZY7Ee\",[\"[[5]]\"]],[45736381,6,null,null,null,null,\"So81Se\"],[45626773,null,true,null,null,null,\"Aj2MYb\"],[45772474,null,false,null,null,null,\"kQrIH\"],[45629637,null,true,null,null,null,\"u0oBhc\"],[45617690,null,true,null,null,null,\"dPLjid\"],[45742660,null,true,null,null,null,\"h8Xqaf\"],[45800798,null,false,null,null,null,\"CX65k\"],[45691102,null,true,null,null,null,\"TH1zib\"],[45797903,null,null,null,\"https://www.gstatic.com/bard-robin-zs/media_gen_templates/discovery/yellow_bg.png\",null,\"PfDJBd\"],[45699561,null,false,null,null,null,\"HV8bzf\"],[45752238,null,true,null,null,null,\"fPxd6b\"],[45428963,null,false,null,null,null,\"wfjXpd\"],[45688644,null,true,null,null,null,\"RJpag\"],[45616225,null,null,null,\"https://www.gstatic.com/lamda/images/app_upsell/upsell_hero_6a6ea7ad39f3a87e36497.gif\",null,\"JmDHue\"],[45779579,null,true,null,null,null,\"ohtFk\"],[45794492,0,null,null,null,null,\"R9SY9b\"],[45678094,1,null,null,null,null,\"JRbYhb\"],[45684703,null,false,null,null,null,\"Ayyfqd\"],[45811846,null,false,null,null,null,\"c0PZuf\"],[45786836,null,true,null,null,null,\"mdN6ge\"],[45733037,null,false,null,null,null,\"bPRiBe\"],[45767715,null,true,null,null,null,\"v