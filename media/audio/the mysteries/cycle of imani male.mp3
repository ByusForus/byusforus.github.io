          <span class="hljs-tag">&lt;<span class="hljs-name">div</span>&gt;</span>
            <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"rev-tag"</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"boycott-tag"</span>&gt;</span>Economic Fast[cite: 1]<span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
            <span class="hljs-tag">&lt;<span class="hljs-name">h3</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"rev-title"</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"boycott-title"</span>&gt;</span>3 + 1 + 3 = 7-Day Economic Fast<span class="hljs-tag">&lt;/<span class="hljs-name">h3</span>&gt;</span>
