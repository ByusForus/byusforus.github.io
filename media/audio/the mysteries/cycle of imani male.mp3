    }

    <span class="hljs-selector-class">.card-number-label</span> {
      <span class="hljs-attribute">font-size</span>: <span class="hljs-number">0.8rem</span>;
      <span class="hljs-attribute">color</span>: <span class="hljs-built_in">var</span>(--text-muted);
      <span class="hljs-attribute">margin-top</span>: <span class="hljs-number">10px</span>;
      <span class="hljs-attribute">font-style</span>: italic;
    }

    <span class="hljs-selector-class">.btn-draw-card</span> {
      <span class="hljs-attribute">background</span>: <span class="hljs-built_in">var</span>(--gold-accent);
