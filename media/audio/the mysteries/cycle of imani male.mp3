      btn.innerHTML = <span class="hljs-string">`&lt;span class="badge"&gt;<span class="hljs-subst">${item.id}</span>&lt;/span&gt; <span class="hljs-subst">${item.btnTitle}</span>`</span>;
      btn.onclick = <span class="hljs-function">() =&gt;</span> {
        <span class="hljs-built_in">document</span>.querySelectorAll(<span class="hljs-string">'#origins-buttons .doctrine-btn'</span>).forEach(<span class="hljs-function"><span class="hljs-params">b</span> =&gt;</span> b.classList.remove(<span class="hljs-string">'active'</span>));
        btn.classList.add(<span class="hljs-string">'active'</span>);
