    <span class="hljs-tag">&lt;/<span class="hljs-name">section</span>&gt;</span>

  <span class="hljs-tag">&lt;/<span class="hljs-name">main</span>&gt;</span>

  <span class="hljs-comment">&lt;!-- Fullscreen Media Lightbox Modal --&gt;</span>
  <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"lightbox-modal"</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"lightbox-backdrop"</span> <span class="hljs-attr">onclick</span>=<span class="hljs-string">"closeMediaLightbox()"</span>&gt;</span>
    <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"lightbox-content"</span> <span class="hljs-attr">onclick</span>=<span class="hljs-string">"event.stopPropagation()"</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">button</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"lightbox-close-btn"</span> <span class="hljs-attr">onclick</span>=<span class="hljs-string">"closeMediaLightbox()"</span>&gt;</span><span class="hljs-symbol">&amp;times;</span><span class="hljs-tag">&lt;/<span class="hljs-name">button</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"lightbox-media-container"</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"lightbox-media-holder"</span>&gt;</span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"lightbox-caption-text"</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"lightbox-caption"</span>&gt;</span><span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
    <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
  <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>

  <span class="hljs-tag">&lt;<span class="hljs-name">script</span>&gt;</span><span class="javascript">
    <span class="hljs-comment">// 1. Holiday Calendar Schedule &amp; Dynamic Countdown Engine</span>
    <span class="hljs-keyword">const</span> federalHolidays = [
      { <span class="hljs-attr">name</span>: <span class="hljs-string">"Labor Day"</span>, <span class="hljs-attr">date</span>: <span class="hljs-keyword">new</span> <span class="hljs-built_in">Date</span>(<span class="hljs-string">"2026-09-07T00:00:00"</span>) },
      { <span class="hljs-attr">name</span>: <span class="hljs-string">"Columbus Day / Indigenous Peoples' Day"</span>, <span class="hljs-attr">date</span>: <span class="hljs-keyword">new</span> <span class="hljs-built_in">Date</span>(<span class="hljs-string">"2026-10-12T00:00:00"</span>) },
      { <span class="hljs-attr">name</span>: <span class="hljs-string">"Veterans Day"</span>, <span class="hljs-attr">date</span>: <span class="hljs-keyword">new</span> <span class="hljs-built_in">Date</span>(<span class="hljs-string">"2026-11-11T00:00:00"</span>) },
      { <span class="hljs-attr">name</span>: <span class="hljs-string">"Thanksgiving Day"</span>, <span class="hljs-attr">date</span>: <span class="hljs-keyword">new</span> <span class="hljs-built_in">Date</span>(<span class="hljs-string">"2026-11-26T00:00:00"</span>) },
      { <span class="hljs-attr">name</span>: <span class="hljs-string">"Christmas Day"</span>, <span class="hljs-attr">date</span>: <span class="hljs-keyword">new</span> <span class="hljs-built_in">Date</span>(<span class="hljs-string">"2026-12-25T00:00:00"</span>) },
      { <span class="hljs-attr">name</span>: <span class="hljs-string">"New Year's Day"</span>, <span class="hljs-attr">date</span>: <span class="hljs-keyword">new</span> <span class="hljs-built_in">Date</span>(<span class="hljs-string">"2027-01-01T00:00:00"</span>) },
      { <span class="hljs-attr">name</span>: <span class="hljs-string">"Martin Luther King Jr. Day"</span>, <span class="hljs-attr">date</span>: <span class="hljs-keyword">new</span> <span class="hljs-built_in">Date</span>(<span class="hljs-string">"2027-01-18T00:00:00"</span>) },
      { <span class="hljs-attr">name</span>: <span class="hljs-string">"Washington's Birthday (Presidents' Day)"</span>, <span class="hljs-attr">date</span>: <span class="hljs-keyword">new</span> <span class="hljs-built_in">Date</span>(<span class="hljs-string">"2027-02-15T00:00:00"</span>) },
      { <span class="hljs-attr">name</span>: <span class="hljs-string">"Memorial Day"</span>, <span class="hljs-attr">date</span>: <span class="hljs-keyword">new</span> <span class="hljs-built_in">Date</span>(<span class="hljs-string">"2027-05-31T00:00:00"</span>) },
      { <span class="hljs-attr">name</span>: <span class="hljs-string">"Juneteenth National Independence Day"</span>, <span class="hljs-attr">date</span>: <span class="hljs-keyword">new</span> <span class="hljs-built_in">Date</span>(<span class="hljs-string">"2027-06-19T00:00:00"</span>) },
      { <span class="hljs-attr">name</span>: <span class="hljs-string">"Independence Day"</span>, <span class="hljs-attr">date</span>: <span class="hljs-keyword">new</span> <span class="hljs-built_in">Date</span>(<span class="hljs-string">"2027-07-04T00:00:00"</span>) }
    ];

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">renderHolidayCalendar</span>(<span class="hljs-params"></span>) </span>{
      <span class="hljs-keyword">const</span> tbody = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'holiday-calendar-rows'</span>);
      tbody.innerHTML = <span class="hljs-string">''</span>;

      federalHolidays.forEach(<span class="hljs-function"><span class="hljs-params">h</span> =&gt;</span> {
        <span class="hljs-keyword">const</span> d = <span class="hljs-keyword">new</span> <span class="hljs-built_in">Date</span>(h.date);
        <span class="hljs-keyword">const</span> prepStart = <span class="hljs-keyword">new</span> <span class="hljs-built_in">Date</span>(d);
        prepStart.setDate(d.getDate() - <span class="hljs-number">3</span>);
        <span class="hljs-keyword">const</span> prepEnd = <span class="hljs-keyword">new</span> <span class="hljs-built_in">Date</span>(d);
        prepEnd.setDate(d.getDate() - <span class="hljs-number">1</span>);

        <span class="hljs-keyword">const</span> followStart = <span class="hljs-keyword">new</span> <span class="hljs-built_in">Date</span>(d);
        followStart.setDate(d.getDate() + <span class="hljs-number">1</span>);
        <span class="hljs-keyword">const</span> followEnd = <span class="hljs-keyword">new</span> <span class="hljs-built_in">Date</span>(d);
        followEnd.setDate(d.getDate() + <span class="hljs-number">3</span>);

        <span class="hljs-keyword">const</span> row = <span class="hljs-built_in">document</span>.createElement(<span class="hljs-string">'tr'</span>);
        row.innerHTML = <span class="hljs-string">`
          &lt;td&gt;&lt;strong&gt;<span class="hljs-subst">${h.name}</span>&lt;/strong&gt;&lt;/td&gt;
          &lt;td style="color: var(--gold-accent); font-weight: 700;"&gt;<span class="hljs-subst">${d.toLocaleDateString(<span class="hljs-string">'en-US'</span>, { month: <span class="hljs-string">'short'</span>, day: <span class="hljs-string">'numeric'</span>, year: <span class="hljs-string">'numeric'</span> })}</span>&lt;/td&gt;
          &lt;td style="color: var(--text-muted);"&gt;<span class="hljs-subst">${prepStart.toLocaleDateString(<span class="hljs-string">'en-US'</span>, { month: <span class="hljs-string">'short'</span>, day: <span class="hljs-string">'numeric'</span> })}</span> – <span class="hljs-subst">${prepEnd.toLocaleDateString(<span class="hljs-string">'en-US'</span>, { month: <span class="hljs-string">'short'</span>, day: <span class="hljs-string">'numeric'</span> })}</span>&lt;/td&gt;
          &lt;td style="color: var(--text-muted);"&gt;<span class="hljs-subst">${followStart.toLocaleDateString(<span class="hljs-string">'en-US'</span>, { month: <span class="hljs-string">'short'</span>, day: <span class="hljs-string">'numeric'</span> })}</span> – <span class="hljs-subst">${followEnd.toLocaleDateString(<span class="hljs-string">'en-US'</span>, { month: <span class="hljs-string">'short'</span>, day: <span class="hljs-string">'numeric'</span> })}</span>&lt;/td&gt;
          &lt;td style="color: var(--emerald-accent); font-weight: 700;"&gt;<span class="hljs-subst">${prepStart.toLocaleDateString(<span class="hljs-string">'en-US'</span>, { month: <span class="hljs-string">'short'</span>, day: <span class="hljs-string">'numeric'</span> })}</span> – <span class="hljs-subst">${followEnd.toLocaleDateString(<span class="hljs-string">'en-US'</span>, { month: <span class="hljs-string">'short'</span>, day: <span class="hljs-string">'numeric'</span>, year: <span class="hljs-string">'numeric'</span> })}</span>&lt;/td&gt;
        `</span>;
        tbody.appendChild(row);
      });
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">exportFastCalendarICS</span>(<span class="hljs-params"></span>) </span>{
      <span class="hljs-keyword">let</span> icsContent = <span class="hljs-string">"BEGIN:VCALENDAR\nVERSION:2.0\nPRODID:-//ImanI Movement//Holiday Economic Fast//EN\n"</span>;
      
      federalHolidays.forEach(<span class="hljs-function"><span class="hljs-params">h</span> =&gt;</span> {
        <span class="hljs-keyword">const</span> start = <span class="hljs-keyword">new</span> <span class="hljs-built_in">Date</span>(h.date);
        start.setDate(start.getDate() - <span class="hljs-number">3</span>);
        <span class="hljs-keyword">const</span> end = <span class="hljs-keyword">new</span> <span class="hljs-built_in">Date</span>(h.date);
        end.setDate(end.getDate() + <span class="hljs-number">4</span>);

        <span class="hljs-keyword">const</span> formatDate = <span class="hljs-function">(<span class="hljs-params">date</span>) =&gt;</span> date.toISOString().replace(<span class="hljs-regexp">/[-:]/g</span>, <span class="hljs-string">""</span>).split(<span class="hljs-string">"."</span>)[<span class="hljs-number">0</span>] + <span class="hljs-string">"Z"</span>;

        icsContent += <span class="hljs-string">"BEGIN:VEVENT\n"</span>;
        icsContent += <span class="hljs-string">`SUMMARY:ImanI 7-Day Economic Fast — <span class="hljs-subst">${h.name}</span>\n`</span>;
        icsContent += <span class="hljs-string">`DESCRIPTION:3+1+3 Silent Solution Economic Fast for <span class="hljs-subst">${h.name}</span>. Unity in Motion and total self-reliance.\n`</span>;
        icsContent += <span class="hljs-string">`DTSTART:<span class="hljs-subst">${formatDate(start)}</span>\n`</span>;
        icsContent += <span class="hljs-string">`DTEND:<span class="hljs-subst">${formatDate(end)}</span>\n`</span>;
        icsContent += <span class="hljs-string">"END:VEVENT\n"</span>;
      });

      icsContent += <span class="hljs-string">"END:VCALENDAR"</span>;

      <span class="hljs-keyword">const</span> blob = <span class="hljs-keyword">new</span> Blob([icsContent], { <span class="hljs-attr">type</span>: <span class="hljs-string">"text/calendar;charset=utf-8"</span> });
      <span class="hljs-keyword">const</span> link = <span class="hljs-built_in">document</span>.createElement(<span class="hljs-string">"a"</span>);
      link.href = URL.createObjectURL(blob);
      link.setAttribute(<span class="hljs-string">"download"</span>, <span class="hljs-string">"ImanI_Economic_Fast_Schedule.ics"</span>);
      <span class="hljs-built_in">document</span>.body.appendChild(link);
      link.click();
      <span class="hljs-built_in">document</span>.body.removeChild(link);
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">getNextFastTarget</span>(<span class="hljs-params"></span>) </span>{
      <span class="hljs-keyword">const</span> now = <span class="hljs-keyword">new</span> <span class="hljs-built_in">Date</span>().getTime();
      <span class="hljs-keyword">for</span> (<span class="hljs-keyword">let</span> h <span class="hljs-keyword">of</span> federalHolidays) {
        <span class="hljs-keyword">const</span> prepStart = <span class="hljs-keyword">new</span> <span class="hljs-built_in">Date</span>(h.date);
        prepStart.setDate(prepStart.getDate() - <span class="hljs-number">3</span>);
        <span class="hljs-keyword">if</span> (prepStart.getTime() &gt; now) {
          <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'banner-holiday-name'</span>).innerText = <span class="hljs-string">`Next Fast: <span class="hljs-subst">${h.name}</span> (<span class="hljs-subst">${prepStart.toLocaleDateString(<span class="hljs-string">'en-US'</span>, { month: <span class="hljs-string">'short'</span>, day: <span class="hljs-string">'numeric'</span> })}</span>)`</span>;
          <span class="hljs-keyword">return</span> prepStart.getTime();
        }
      }
      <span class="hljs-keyword">return</span> now + (<span class="hljs-number">7</span> * <span class="hljs-number">24</span> * <span class="hljs-number">60</span> * <span class="hljs-number">60</span> * <span class="hljs-number">1000</span>);
    }

    <span class="hljs-keyword">let</span> pauseTargetDate = getNextFastTarget();

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">updateCountdown</span>(<span class="hljs-params"></span>) </span>{
      <span class="hljs-keyword">const</span> now = <span class="hljs-keyword">new</span> <span class="hljs-built_in">Date</span>().getTime();
      <span class="hljs-keyword">const</span> distance = pauseTargetDate - now;

      <span class="hljs-keyword">if</span> (distance &lt; <span class="hljs-number">0</span>) {
        pauseTargetDate = getNextFastTarget();
        <span class="hljs-keyword">return</span>;
      }

      <span class="hljs-keyword">const</span> days = <span class="hljs-built_in">Math</span>.floor(distance / (<span class="hljs-number">1000</span> * <span class="hljs-number">60</span> * <span class="hljs-number">60</span> * <span class="hljs-number">24</span>));
      <span class="hljs-keyword">const</span> hours = <span class="hljs-built_in">Math</span>.floor((distance % (<span class="hljs-number">1000</span> * <span class="hljs-number">60</span> * <span class="hljs-number">60</span> * <span class="hljs-number">24</span>)) / (<span class="hljs-number">1000</span> * <span class="hljs-number">60</span> * <span class="hljs-number">60</span>));
      <span class="hljs-keyword">const</span> mins = <span class="hljs-built_in">Math</span>.floor((distance % (<span class="hljs-number">1000</span> * <span class="hljs-number">60</span>)) / (<span class="hljs-number">1000</span> * <span class="hljs-number">60</span>));
      <span class="hljs-keyword">const</span> secs = <span class="hljs-built_in">Math</span>.floor((distance % (<span class="hljs-number">1000</span> * <span class="hljs-number">60</span>)) / <span class="hljs-number">1000</span>);

      <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'cd-days'</span>).innerText = <span class="hljs-built_in">String</span>(days).padStart(<span class="hljs-number">2</span>, <span class="hljs-string">'0'</span>);
      <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'cd-hours'</span>).innerText = <span class="hljs-built_in">String</span>(hours).padStart(<span class="hljs-number">2</span>, <span class="hljs-string">'0'</span>);
      <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'cd-mins'</span>).innerText = <span class="hljs-built_in">String</span>(mins).padStart(<span class="hljs-number">2</span>, <span class="hljs-string">'0'</span>);
      <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'cd-secs'</span>).innerText = <span class="hljs-built_in">String</span>(secs).padStart(<span class="hljs-number">2</span>, <span class="hljs-string">'0'</span>);
    }

    <span class="hljs-built_in">setInterval</span>(updateCountdown, <span class="hljs-number">1000</span>);
    updateCountdown();
    renderHolidayCalendar();

    <span class="hljs-comment">// 2. Standby Audio Mute/Unmute Toggle</span>
    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">toggleStandbyAudio</span>(<span class="hljs-params"></span>) </span>{
      <span class="hljs-keyword">const</span> standbyVideo = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'standby-motion-player'</span>);
      <span class="hljs-keyword">const</span> text = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'standby-mute-text'</span>);
      <span class="hljs-keyword">if</span> (standbyVideo.muted) {
        standbyVideo.muted = <span class="hljs-literal">false</span>;
        standbyVideo.volume = <span class="hljs-number">0.85</span>;
        text.innerText = <span class="hljs-string">"Mute Music"</span>;
      } <span class="hljs-keyword">else</span> {
        standbyVideo.muted = <span class="hljs-literal">true</span>;
        text.innerText = <span class="hljs-string">"Unmute Music"</span>;
      }
    }

    <span class="hljs-comment">// 3. Stage Live Chat Engine</span>
    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">sendChatMessage</span>(<span class="hljs-params"></span>) </span>{
      <span class="hljs-keyword">const</span> input = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'chat-input-field'</span>);
      <span class="hljs-keyword">const</span> text = input.value.trim();
      <span class="hljs-keyword">if</span> (!text) <span class="hljs-keyword">return</span>;

      <span class="hljs-keyword">const</span> container = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'chat-messages-container'</span>);
      <span class="hljs-keyword">const</span> bubble = <span class="hljs-built_in">document</span>.createElement(<span class="hljs-string">'div'</span>);
      bubble.className = <span class="hljs-string">'chat-bubble'</span>;
      bubble.innerHTML = <span class="hljs-string">`
        &lt;span class="chat-author gold"&gt;Initiate&lt;/span&gt;
        &lt;span class="chat-text"&gt;<span class="hljs-subst">${text}</span>&lt;/span&gt;
      `</span>;
      container.appendChild(bubble);
      container.scrollTop = container.scrollHeight;
      input.value = <span class="hljs-string">''</span>;
    }

    <span class="hljs-comment">// 4. Speech Synthesis Narration Engine</span>
    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">narrateText</span>(<span class="hljs-params">titleId, descId</span>) </span>{
      <span class="hljs-keyword">if</span> (!(<span class="hljs-string">'speechSynthesis'</span> <span class="hljs-keyword">in</span> <span class="hljs-built_in">window</span>)) {
        alert(<span class="hljs-string">"Text-to-speech is not supported on this browser."</span>);
        <span class="hljs-keyword">return</span>;
      }
      <span class="hljs-built_in">window</span>.speechSynthesis.cancel();

      <span class="hljs-keyword">const</span> title = <span class="hljs-built_in">document</span>.getElementById(titleId).innerText;
      <span class="hljs-keyword">const</span> descElement = <span class="hljs-built_in">document</span>.getElementById(descId);
      <span class="hljs-keyword">const</span> textToRead = <span class="hljs-string">`<span class="hljs-subst">${title}</span>. <span class="hljs-subst">${descElement.innerText || descElement.textContent}</span>`</span>;

      <span class="hljs-keyword">const</span> utterance = <span class="hljs-keyword">new</span> SpeechSynthesisUtterance(textToRead);
      utterance.rate = <span class="hljs-number">0.95</span>;
      utterance.pitch = <span class="hljs-number">1.0</span>;
      <span class="hljs-built_in">window</span>.speechSynthesis.speak(utterance);
    }

    <span class="hljs-comment">// 5. Fullscreen Lightbox Modal</span>
    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">openMediaLightbox</span>(<span class="hljs-params">src, type, caption</span>) </span>{
      <span class="hljs-keyword">const</span> modal = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'lightbox-modal'</span>);
      <span class="hljs-keyword">const</span> container = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'lightbox-media-container'</span>);
      <span class="hljs-keyword">const</span> cap = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'lightbox-caption-text'</span>);

      container.innerHTML = <span class="hljs-string">''</span>;
      <span class="hljs-keyword">if</span> (type === <span class="hljs-string">'video'</span>) {
        container.innerHTML = <span class="hljs-string">`&lt;video src="<span class="hljs-subst">${src}</span>" controls autoplay playsinline style="width:100%; max-height:75vh;"&gt;&lt;/video&gt;`</span>;
      } <span class="hljs-keyword">else</span> {
        container.innerHTML = <span class="hljs-string">`&lt;img src="<span class="hljs-subst">${src}</span>" style="width:100%; max-height:75vh; object-fit:contain;"&gt;`</span>;
      }
      cap.innerText = caption;
      modal.style.display = <span class="hljs-string">'flex'</span>;
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">closeMediaLightbox</span>(<span class="hljs-params"></span>) </span>{
      <span class="hljs-keyword">const</span> modal = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'lightbox-modal'</span>);
      <span class="hljs-keyword">const</span> container = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'lightbox-media-container'</span>);
      container.innerHTML = <span class="hljs-string">''</span>;
      modal.style.display = <span class="hljs-string">'none'</span>;
    }

    <span class="hljs-comment">// 6. Image Fallbacks</span>
    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">handleImageError</span>(<span class="hljs-params">img</span>) </span>{
      <span class="hljs-keyword">const</span> savedEmblem = <span class="hljs-built_in">localStorage</span>.getItem(<span class="hljs-string">'imani_header_emblem'</span>);
      <span class="hljs-keyword">if</span> (savedEmblem) {
        img.src = savedEmblem;
        img.style.display = <span class="hljs-string">'block'</span>;
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'emblem-picker-box'</span>).style.display = <span class="hljs-string">'none'</span>;
      } <span class="hljs-keyword">else</span> {
        img.style.display = <span class="hljs-string">'none'</span>;
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'emblem-picker-box'</span>).style.display = <span class="hljs-string">'inline-block'</span>;
      }
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">handleChattyImageError</span>(<span class="hljs-params">img</span>) </span>{
      <span class="hljs-keyword">const</span> savedChatty = <span class="hljs-built_in">localStorage</span>.getItem(<span class="hljs-string">'chatty_wisdom_header'</span>);
      <span class="hljs-keyword">if</span> (savedChatty) {
        img.src = savedChatty;
        img.style.display = <span class="hljs-string">'block'</span>;
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'chatty-fallback-text'</span>).style.display = <span class="hljs-string">'none'</span>;
      } <span class="hljs-keyword">else</span> {
        img.style.display = <span class="hljs-string">'none'</span>;
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'chatty-fallback-text'</span>).style.display = <span class="hljs-string">'block'</span>;
      }
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">handleChattyLandscapeError</span>(<span class="hljs-params">img</span>) </span>{
      <span class="hljs-keyword">const</span> savedLandscape = <span class="hljs-built_in">localStorage</span>.getItem(<span class="hljs-string">'chatty_landscape_image'</span>);
      <span class="hljs-keyword">if</span> (savedLandscape) {
        img.src = savedLandscape;
        img.style.display = <span class="hljs-string">'block'</span>;
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'chatty-landscape-picker'</span>).style.display = <span class="hljs-string">'none'</span>;
      } <span class="hljs-keyword">else</span> {
        img.style.display = <span class="hljs-string">'none'</span>;
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'chatty-landscape-picker'</span>).style.display = <span class="hljs-string">'block'</span>;
      }
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">triggerFileSelect</span>(<span class="hljs-params">inputId</span>) </span>{
      <span class="hljs-built_in">document</span>.getElementById(inputId).click();
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">loadUserImage</span>(<span class="hljs-params">event, imgId, fallbackId, storageKey</span>) </span>{
      <span class="hljs-keyword">const</span> file = event.target.files[<span class="hljs-number">0</span>];
      <span class="hljs-keyword">if</span> (file) {
        <span class="hljs-keyword">const</span> reader = <span class="hljs-keyword">new</span> FileReader();
        reader.onload = <span class="hljs-function"><span class="hljs-keyword">function</span>(<span class="hljs-params">e</span>) </span>{
          <span class="hljs-keyword">const</span> imgData = e.target.result;
          <span class="hljs-built_in">localStorage</span>.setItem(storageKey, imgData);
          <span class="hljs-keyword">const</span> img = <span class="hljs-built_in">document</span>.getElementById(imgId);
          <span class="hljs-keyword">if</span> (img) {
            img.src = imgData;
            img.style.display = <span class="hljs-string">'block'</span>;
          }
          <span class="hljs-keyword">if</span> (fallbackId &amp;&amp; <span class="hljs-built_in">document</span>.getElementById(fallbackId)) {
            <span class="hljs-built_in">document</span>.getElementById(fallbackId).style.display = <span class="hljs-string">'none'</span>;
          }
        };
        reader.readAsDataURL(file);
      }
    }

    <span class="hljs-comment">// 7. Stage State &amp; Dynamic Stream Poller</span>
    <span class="hljs-keyword">let</span> hlsInstance = <span class="hljs-literal">null</span>;

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">setStageState</span>(<span class="hljs-params">isLive, badgeText = <span class="hljs-string">"ON AIR • LIVE"</span></span>) </span>{
      <span class="hljs-keyword">const</span> liveVideo = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'live-video-player'</span>);
      <span class="hljs-keyword">const</span> standbyVideo = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'standby-motion-player'</span>);
      <span class="hljs-keyword">const</span> liveBadge = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'live-indicator'</span>);
      <span class="hljs-keyword">const</span> muteBtn = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'standby-mute-btn'</span>);

      <span class="hljs-keyword">if</span> (isLive) {
        standbyVideo.style.display = <span class="hljs-string">"none"</span>;
        standbyVideo.pause();
        muteBtn.style.display = <span class="hljs-string">"none"</span>;
        liveVideo.style.display = <span class="hljs-string">"block"</span>;
        liveBadge.innerText = badgeText;
        liveBadge.style.borderColor = <span class="hljs-string">"var(--gold-accent)"</span>;
        liveBadge.style.color = <span class="hljs-string">"var(--gold-accent)"</span>;
      } <span class="hljs-keyword">else</span> {
        liveVideo.pause();
        liveVideo.src = <span class="hljs-string">""</span>;
        liveVideo.style.display = <span class="hljs-string">"none"</span>;
        standbyVideo.style.display = <span class="hljs-string">"block"</span>;
        muteBtn.style.display = <span class="hljs-string">"flex"</span>;
        standbyVideo.play().catch(<span class="hljs-function">() =&gt;</span> {});
        liveBadge.innerText = <span class="hljs-string">"STANDBY • WE R IMANI"</span>;
        liveBadge.style.borderColor = <span class="hljs-string">"var(--emerald-accent)"</span>;
        liveBadge.style.color = <span class="hljs-string">"var(--emerald-accent)"</span>;
      }
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">connectLiveStream</span>(<span class="hljs-params"></span>) </span>{
      <span class="hljs-keyword">const</span> video = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'live-video-player'</span>);
      <span class="hljs-keyword">const</span> streamUrl = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'stream-source-url'</span>).value.trim();

      <span class="hljs-keyword">if</span> (!streamUrl) <span class="hljs-keyword">return</span>;

      <span class="hljs-keyword">if</span> (hlsInstance) {
        hlsInstance.destroy();
        hlsInstance = <span class="hljs-literal">null</span>;
      }

      <span class="hljs-keyword">if</span> (streamUrl.includes(<span class="hljs-string">'.m3u8'</span>)) {
        <span class="hljs-keyword">if</span> (Hls.isSupported()) {
          hlsInstance = <span class="hljs-keyword">new</span> Hls({
            <span class="hljs-attr">liveSyncDurationCount</span>: <span class="hljs-number">3</span>,
            <span class="hljs-attr">liveMaxLatencyDurationCount</span>: <span class="hljs-number">5</span>,
            <span class="hljs-attr">enableWorker</span>: <span class="hljs-literal">true</span>
          });
          hlsInstance.loadSource(streamUrl);
          hlsInstance.attachMedia(video);
          hlsInstance.on(Hls.Events.MANIFEST_PARSED, <span class="hljs-function"><span class="hljs-keyword">function</span> (<span class="hljs-params"></span>) </span>{
            setStageState(<span class="hljs-literal">true</span>, <span class="hljs-string">"ON AIR • HLS LIVE"</span>);
            video.play().catch(<span class="hljs-function">() =&gt;</span> {});
          });
          hlsInstance.on(Hls.Events.ERROR, <span class="hljs-function"><span class="hljs-keyword">function</span> (<span class="hljs-params">event, data</span>) </span>{
            <span class="hljs-keyword">if</span> (data.fatal) {
              setStageState(<span class="hljs-literal">false</span>);
            }
          });
        } <span class="hljs-keyword">else</span> <span class="hljs-keyword">if</span> (video.canPlayType(<span class="hljs-string">'application/vnd.apple.mpegurl'</span>)) {
          video.src = streamUrl;
          video.onloadedmetadata = <span class="hljs-function">() =&gt;</span> {
            setStageState(<span class="hljs-literal">true</span>, <span class="hljs-string">"ON AIR • LIVE"</span>);
            video.play().catch(<span class="hljs-function">() =&gt;</span> {});
          };
          video.onerror = <span class="hljs-function">() =&gt;</span> setStageState(<span class="hljs-literal">false</span>);
        }
      } <span class="hljs-keyword">else</span> {
        video.src = streamUrl;
        video.onloadeddata = <span class="hljs-function">() =&gt;</span> {
          setStageState(<span class="hljs-literal">true</span>, <span class="hljs-string">"MEDIA FEED ACTIVE"</span>);
          video.play().catch(<span class="hljs-function">() =&gt;</span> {});
        };
        video.onerror = <span class="hljs-function">() =&gt;</span> setStageState(<span class="hljs-literal">false</span>);
      }
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">pollStreamHealth</span>(<span class="hljs-params"></span>) </span>{
      <span class="hljs-keyword">const</span> streamUrl = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'stream-source-url'</span>).value.trim();
      <span class="hljs-keyword">if</span> (!streamUrl || !streamUrl.includes(<span class="hljs-string">'.m3u8'</span>)) <span class="hljs-keyword">return</span>;

      fetch(streamUrl, { <span class="hljs-attr">method</span>: <span class="hljs-string">'HEAD'</span>, <span class="hljs-attr">cache</span>: <span class="hljs-string">'no-store'</span> })
        .then(<span class="hljs-function"><span class="hljs-params">res</span> =&gt;</span> {
          <span class="hljs-keyword">if</span> (res.ok) {
            <span class="hljs-keyword">const</span> liveVideo = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'live-video-player'</span>);
            <span class="hljs-keyword">if</span> (liveVideo.style.display === <span class="hljs-string">"none"</span>) {
              connectLiveStream();
            }
          } <span class="hljs-keyword">else</span> {
            setStageState(<span class="hljs-literal">false</span>);
          }
        })
        .catch(<span class="hljs-function">() =&gt;</span> {
          <span class="hljs-comment">// Stream is currently offline, keep standby video playing</span>
        });
    }

    <span class="hljs-built_in">setInterval</span>(pollStreamHealth, <span class="hljs-number">15000</span>);

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">loadLocalVideoFile</span>(<span class="hljs-params">event</span>) </span>{
      <span class="hljs-keyword">const</span> file = event.target.files[<span class="hljs-number">0</span>];
      <span class="hljs-keyword">if</span> (file) {
        <span class="hljs-keyword">const</span> video = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'live-video-player'</span>);
        <span class="hljs-keyword">if</span> (hlsInstance) {
          hlsInstance.destroy();
          hlsInstance = <span class="hljs-literal">null</span>;
        }
        setStageState(<span class="hljs-literal">true</span>, <span class="hljs-string">`PLAYING: <span class="hljs-subst">${file.name.slice(<span class="hljs-number">0</span>, <span class="hljs-number">18</span>)}</span>...`</span>);
        video.src = URL.createObjectURL(file);
        video.play().catch(<span class="hljs-function">() =&gt;</span> {});
      }
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">loadStandbyVideoFile</span>(<span class="hljs-params">event</span>) </span>{
      <span class="hljs-keyword">const</span> file = event.target.files[<span class="hljs-number">0</span>];
      <span class="hljs-keyword">if</span> (file) {
        <span class="hljs-keyword">const</span> standbyVideo = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'standby-motion-player'</span>);
        standbyVideo.src = URL.createObjectURL(file);
        standbyVideo.play().catch(<span class="hljs-function">() =&gt;</span> {});
      }
    }

    <span class="hljs-comment">// 8. Service Worker Registration for PWA</span>
    <span class="hljs-keyword">if</span> (<span class="hljs-string">'serviceWorker'</span> <span class="hljs-keyword">in</span> navigator) {
      <span class="hljs-built_in">window</span>.addEventListener(<span class="hljs-string">'load'</span>, <span class="hljs-function">() =&gt;</span> {
        navigator.serviceWorker.register(<span class="hljs-string">'./sw.js'</span>).catch(<span class="hljs-function">() =&gt;</span> {});
      });
    }

    <span class="hljs-comment">// Auto-load saved images &amp; initialize stage</span>
    <span class="hljs-built_in">window</span>.addEventListener(<span class="hljs-string">'DOMContentLoaded'</span>, <span class="hljs-function">() =&gt;</span> {
      <span class="hljs-keyword">const</span> savedEmblem = <span class="hljs-built_in">localStorage</span>.getItem(<span class="hljs-string">'imani_header_emblem'</span>);
      <span class="hljs-keyword">if</span> (savedEmblem) {
        <span class="hljs-keyword">const</span> img = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'header-emblem-view'</span>);
        img.src = savedEmblem;
        img.style.display = <span class="hljs-string">'block'</span>;
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'emblem-picker-box'</span>).style.display = <span class="hljs-string">'none'</span>;
      }

      <span class="hljs-keyword">const</span> savedChatty = <span class="hljs-built_in">localStorage</span>.getItem(<span class="hljs-string">'chatty_wisdom_header'</span>);
      <span class="hljs-keyword">if</span> (savedChatty) {
        <span class="hljs-keyword">const</span> img = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'chatty-header-view'</span>);
        img.src = savedChatty;
        img.style.display = <span class="hljs-string">'block'</span>;
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'chatty-fallback-text'</span>).style.display = <span class="hljs-string">'none'</span>;
      }

      <span class="hljs-keyword">const</span> savedLandscape = <span class="hljs-built_in">localStorage</span>.getItem(<span class="hljs-string">'chatty_landscape_image'</span>);
      <span class="hljs-keyword">if</span> (savedLandscape) {
        <span class="hljs-keyword">const</span> img = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'chatty-landscape-view'</span>);
        img.src = savedLandscape;
        img.style.display = <span class="hljs-string">'block'</span>;
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'chatty-landscape-picker'</span>).style.display = <span class="hljs-string">'none'</span>;
      }

      [<span class="hljs-string">'1'</span>, <span class="hljs-string">'2'</span>, <span class="hljs-string">'3'</span>].forEach(<span class="hljs-function"><span class="hljs-params">num</span> =&gt;</span> {
        <span class="hljs-keyword">const</span> savedSlot = <span class="hljs-built_in">localStorage</span>.getItem(<span class="hljs-string">`gallery_slot_<span class="hljs-subst">${num}</span>`</span>);
        <span class="hljs-keyword">if</span> (savedSlot) {
          <span class="hljs-keyword">const</span> img = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">`gallery-img-<span class="hljs-subst">${num}</span>`</span>);
          <span class="hljs-keyword">if</span> (img) img.src = savedSlot;
        }
        <span class="hljs-keyword">const</span> savedBoycottSlot = <span class="hljs-built_in">localStorage</span>.getItem(<span class="hljs-string">`boycott_slot_<span class="hljs-subst">${num}</span>`</span>);
        <span class="hljs-keyword">if</span> (savedBoycottSlot) {
          <span class="hljs-keyword">const</span> img = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">`boycott-img-<span class="hljs-subst">${num}</span>`</span>);
          <span class="hljs-keyword">if</span> (img) img.src = savedBoycottSlot;
        }
      });

      <span class="hljs-keyword">const</span> standbyVideo = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'standby-motion-player'</span>);
      standbyVideo.play().catch(<span class="hljs-function">() =&gt;</span> {});

      <span class="hljs-built_in">setTimeout</span>(<span class="hljs-function">() =&gt;</span> {
        connectLiveStream();
      }, <span class="hljs-number">1000</span>);
    });

    <span class="hljs-comment">// 9. Matrix Data Arrays</span>
    <span class="hljs-keyword">const</span> originsData = [
      { <span class="hljs-attr">id</span>: <span class="hljs-string">"01"</span>, <span class="hljs-attr">btnTitle</span>: <span class="hljs-string">"Sovereign Ontology"</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Ontology"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Sovereign Ontology"</span>, <span class="hljs-attr">desc</span>: <span class="hljs-string">"Moving away from assigned, descriptive adjectives like 'black' that describe a shadow or condition, &lt;strong&gt;ImanI&lt;/strong&gt; is a proper noun representing a sovereign ontology, a spiritual nationality, and a return to original character."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-string">"02"</span>, <span class="hljs-attr">btnTitle</span>: <span class="hljs-string">"The People of Faith"</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Lineage &amp; Faith"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The People of Faith"</span>, <span class="hljs-attr">desc</span>: <span class="hljs-string">"After slavery, Reconstruction, Jim Crow, Civil Rights Bill who is better to be called the people of faith here in america then the descendants of the emaciated slaves of 1863 the original 14th amendment americans. This is a part of our lineage."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-string">"03"</span>, <span class="hljs-attr">btnTitle</span>: <span class="hljs-string">"Faith in Action"</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Origin"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Faith in Action"</span>, <span class="hljs-attr">desc</span>: <span class="hljs-string">"Rooted in the Swahili concept of &lt;em&gt;Imani&lt;/em&gt; (Faith), transforming passive belief into active alignment with divine law and collective purpose."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-string">"04"</span>, <span class="hljs-attr">btnTitle</span>: <span class="hljs-string">"Proper Noun Identity"</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Grammar of Spirit"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Proper Noun Identity"</span>, <span class="hljs-attr">desc</span>: <span class="hljs-string">"Replacing modifiers that depend on external systems with a sovereign name that declares self-existence and heritage."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-string">"05"</span>, <span class="hljs-attr">btnTitle</span>: <span class="hljs-string">"I M Very Beautiful"</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"The Affirmation"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"I M Very Beautiful"</span>, <span class="hljs-attr">desc</span>: <span class="hljs-string">"Combining 'I M' (existence) with the ancient 'ani' (very beautiful). Every time the name is spoken, it carries a sacred blessing."</span> }
    ];

    <span class="hljs-keyword">const</span> mysteriesData = [
      { <span class="hljs-attr">id</span>: <span class="hljs-string">"01"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Alpha and Omega"</span>, <span class="hljs-attr">desc</span>: <span class="hljs-string">"The two capitalized 'I' bookends symbolize the eternal cycle—the Creator at the beginning and defending the culmination."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-string">"02"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"God in Me / Divine Soul"</span>, <span class="hljs-attr">desc</span>: <span class="hljs-string">"The 'man' nestled in the center represents the sacred truth that the Divine Soul resides in man and man in the Divine Soul."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-string">"03"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Pillars of Solomon"</span>, <span class="hljs-attr">desc</span>: <span class="hljs-string">"Boaz and Jachin stand as the gateway of transformation where the past is forgotten and sovereign life begins anew."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-string">"04"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Solar &amp; Lunar Power"</span>, <span class="hljs-attr">desc</span>: <span class="hljs-string">"The harmonious balance atop the pillars: Sun (protective vision / man) and Moon (intuitive depth / woman) working in unison."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-string">"05"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"I and I"</span>, <span class="hljs-attr">desc</span>: <span class="hljs-string">"Universal unity with the divine and community—seeing the self reflected in the brother, the sister, and creation."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-string">"06"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"I M (Existence)"</span>, <span class="hljs-attr">desc</span>: <span class="hljs-string">"Echoing the supreme declaration 'I am that I am,' affirming existence, direct lineage, and unborrowed authority."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-string">"07"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"I M ani (Inherent Beauty)"</span>, <span class="hljs-attr">desc</span>: <span class="hljs-string">"Affirming beauty, dignity, and grace, discarding external standards to declare internal, divine perfection."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-string">"08"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Initiation (1 0 1)"</span>, <span class="hljs-attr">desc</span>: <span class="hljs-string">"Standing consciously between the pillars (I M I / 1 0 1) to step forward into the awakening of the new breed."</span> },
