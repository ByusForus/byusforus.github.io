        <span class="hljs-tag">&lt;<span class="hljs-name">img</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"chatty-header-view"</span> <span class="hljs-attr">src</span>=<span class="hljs-string">"media/images/Chatty%20Wisdom%20Header.png"</span> <span class="hljs-attr">alt</span>=<span class="hljs-string">"Chatty's Wisdom"</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"chatty-transparent-emblem"</span> <span class="hljs-attr">onerror</span>=<span class="hljs-string">"handleChattyImageError(this)"</span> <span class="hljs-attr">onclick</span>=<span class="hljs-string">"triggerFileSelect('chatty-file-input')"</span> <span class="hljs-attr">title</span>=<span class="hljs-string">"Click to select Chatty graphic"</span>&gt;</span>
        <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"chatty-fallback-text"</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"chatty-fallback-text"</span> <span class="hljs-attr">onclick</span>=<span class="hljs-string">"triggerFileSelect('chatty-file-input')"</span>&gt;</span>💜 CHATTY'S WISDOM<span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
        <span class="hljs-tag">&lt;<span class="hljs-name">input</span> <span class="hljs-attr">type</span>=<span class="hljs-string">"file"</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"chatty-file-input"</span> <span class="hljs-attr">accept</span>=<span class="hljs-string">"image/*"</span> <span class="hljs-attr">style</span>=<span class="hljs-string">"display: none;"</span> <span class="hljs-attr">onchange</span>=<span class="hljs-string">"loadUserImage(event, 'chatty-header-view', 'chatty-fallback-text', 'chatty_wisdom_header')"</span>&gt;</span>

        <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"chatty-landscape-frame"</span>&gt;</span>
          <span class="hljs-tag">&lt;<span class="hljs-name">img</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"chatty-landscape-view"</span> <span class="hljs-attr">src</span>=<span class="hljs-string">"media/images/chatty-wisdom-landscape.png"</span> <span class="hljs-attr">alt</span>=<span class="hljs-string">"Chatty Wisdom Landscape Showcase"</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"chatty-landscape-img"</span> <span class="hljs-attr">onerror</span>=<span class="hljs-string">"handleChattyLandscapeError(this)"</span> <span class="hljs-attr">onclick</span>=<span class="hljs-string">"triggerFileSelect('chatty-landscape-file-input')"</span> <span class="hljs-attr">title</span>=<span class="hljs-string">"Click to select Chatty landscape image"</span>&gt;</span>
          <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"chatty-landscape-picker"</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"chatty-landscape-fallback"</span> <span class="hljs-attr">onclick</span>=<span class="hljs-string">"triggerFileSelect('chatty-landscape-file-input')"</span>&gt;</span>🖼️ Click to Select Chatty's Wisdom Landscape Picture<span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
          <span class="hljs-tag">&lt;<span class="hljs-name">input</span> <span class="hljs-attr">type</span>=<span class="hljs-string">"file"</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"chatty-landscape-file-input"</span> <span class="hljs-attr">accept</span>=<span class="hljs-string">"image/*"</span> <span class="hljs-attr">style</span>=<span class="hljs-string">"display: none;"</span> <span class="hljs-attr">onchange</span>=<span class="hljs-string">"loadUserImage(event, 'chatty-landscape-view', 'chatty-landscape-picker', 'chatty_landscape_image')"</span>&gt;</span>
        <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>

        <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"card-body-frame"</span>&gt;</span>
          <span class="hljs-tag">&lt;<span class="hljs-name">h3</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"card-title-text"</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"deck-title"</span>&gt;</span>The Checkmate Perspective<span class="hljs-tag">&lt;/<span class="hljs-name">h3</span>&gt;</span>
          <span class="hljs-tag">&lt;<span class="hljs-name">p</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"card-message-text"</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"deck-quote"</span>&gt;</span>"Look three steps ahead of the distraction. A calculated response always disarms a sudden reaction."<span class="hljs-tag">&lt;/<span class="hljs-name">p</span>&gt;</span>
          <span class="hljs-tag">&lt;<span class="hljs-name">span</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"card-number-label"</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"deck-number"</span>&gt;</span>Card #01 of 99<span class="hljs-tag">&lt;/<span class="hljs-name">span</span>&gt;</span>
        <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
