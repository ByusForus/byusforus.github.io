      { <span class="hljs-attr">id</span>: <span class="hljs-number">52</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Strategy"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Sacred Union"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Harmonize the Sun and Moon within yourself before seeking external balance."</span> },
