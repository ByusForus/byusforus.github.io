      { <span class="hljs-attr">id</span>: <span class="hljs-number">75</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Strategy"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Alpha Standard"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Start every endeavor with pure intention and divine alignment."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">76</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Strategy"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Omega Shield"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Finish what you begin. Completion secures the generational victory."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">77</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Lineage"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Sovereign Creed"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Faith in action transforms the condition of the people into sovereign power."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">78</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Strategy"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Board Master"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Study the entire field, not just the nearest square. Vision wins the war."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">79</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Lineage"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Sacred Heritage"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Honor your lineage history. Forgetting your origin weakens your future."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">80</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Lineage"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Silent Anchor"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Anchor your heart in divine love; it is the source of all real strength."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">81</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Strategy"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Pillar Balance"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Stand tall between Boaz and Jachin. Let balance guide every decision."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">82</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Economics"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Specie Reserve"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Store your treasures in real value. Let paper remain outside your sanctuary."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">83</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Economics"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Economic Integrity"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Do not sell your birthright for temporary conveniences."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">84</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Stealth"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Curious Path"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Listen more than you speak. Insight is gained through quiet curiosity."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">85</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Lineage"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Lotus Grace"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Purity of character is your highest crown. Wear it with sovereign pride."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">86</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Strategy"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The True Defense"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"A righteous cause defended with calm strategy is invincible."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">87</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Lineage"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Sovereign Mindset"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"You are not a subject of external systems; you are sovereign by origin."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">88</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Stealth"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Shielded Thoughts"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Filter out chaotic frequencies. Tune your mind to high divine purpose."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">89</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Stealth"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Tactical Pause"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"When challenged, pause and breathe. That second of silence gives you control."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">90</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Lineage"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The 101 Awakening"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Step through the initiation of truth. Walk as the sovereign new breed."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">91</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Economics"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Sovereign Economy"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Create value from your own hands, mind, and soil. Self-reliance is power."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">92</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Lineage"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Onyx Standard"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Black is a condition; Onyx is sovereign nobility, density, and value."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">93</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Economics"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Gold Standard"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Gold represents destiny fulfilled. Never settle for less than your value."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">94</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Lineage"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Emerald Standard"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Emerald is rebirth and awakening. Rise anew with each rising sun."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">95</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Stealth"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"Mastery of Speech"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Let your words be few, precise, and impeccable. Speak life into existence."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">96</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Strategy"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Sovereign Code"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"Live by the ten activities in harmony. Complete mastery brings complete peace."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">97</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Strategy"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Final Checkmate"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"When truth is spoken without fear, all illusions collapse in checkmate."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">98</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Lineage"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Eternal Circle"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"From Alpha to Omega, the divine soul remains unbroken and victorious."</span> },
      { <span class="hljs-attr">id</span>: <span class="hljs-number">99</span>, <span class="hljs-attr">tag</span>: <span class="hljs-string">"Lineage"</span>, <span class="hljs-attr">title</span>: <span class="hljs-string">"The Sovereign Crown"</span>, <span class="hljs-attr">quote</span>: <span class="hljs-string">"You are ImanI: sovereign, faithful, and beautiful. Stand firm in your power."</span> }
    ];

    <span class="hljs-keyword">let</span> currentDeckTag = <span class="hljs-string">"ALL"</span>;
    <span class="hljs-keyword">let</span> activeWisdomPool = [...chattyDeck];
    <span class="hljs-keyword">let</span> lastDrawnIndex = -<span class="hljs-number">1</span>;

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">setDeckTagFilter</span>(<span class="hljs-params">tag, btn</span>) </span>{
      currentDeckTag = tag;
      <span class="hljs-built_in">document</span>.querySelectorAll(<span class="hljs-string">'.filter-tag-btn'</span>).forEach(<span class="hljs-function"><span class="hljs-params">b</span> =&gt;</span> b.classList.remove(<span class="hljs-string">'active'</span>));
      btn.classList.add(<span class="hljs-string">'active'</span>);
      filterWisdomDeck();
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">filterWisdomDeck</span>(<span class="hljs-params"></span>) </span>{
      <span class="hljs-keyword">const</span> search = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'wisdom-search'</span>).value.toLowerCase().trim();
      activeWisdomPool = chattyDeck.filter(<span class="hljs-function"><span class="hljs-params">card</span> =&gt;</span> {
        <span class="hljs-keyword">const</span> matchesTag = (currentDeckTag === <span class="hljs-string">"ALL"</span> || card.tag === currentDeckTag);
        <span class="hljs-keyword">const</span> matchesSearch = (!search || card.title.toLowerCase().includes(search) || card.quote.toLowerCase().includes(search));
        <span class="hljs-keyword">return</span> matchesTag &amp;&amp; matchesSearch;
      });
      drawWisdomCard();
    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">drawWisdomCard</span>(<span class="hljs-params"></span>) </span>{
      <span class="hljs-keyword">if</span> (activeWisdomPool.length === <span class="hljs-number">0</span>) {
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'deck-title'</span>).innerText = <span class="hljs-string">"No Matching Wisdom Found"</span>;
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'deck-quote'</span>).innerText = <span class="hljs-string">"Adjust your search filter to draw from the 99 sovereign principles."</span>;
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'deck-number'</span>).innerText = <span class="hljs-string">"Card 0 of 0"</span>;
        <span class="hljs-keyword">return</span>;
      }

      <span class="hljs-keyword">const</span> container = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'wisdom-card-container'</span>);
      container.style.opacity = <span class="hljs-string">'0.5'</span>;
      
      <span class="hljs-built_in">setTimeout</span>(<span class="hljs-function">() =&gt;</span> {
        <span class="hljs-keyword">let</span> randomIndex;
        <span class="hljs-keyword">do</span> {
          randomIndex = <span class="hljs-built_in">Math</span>.floor(<span class="hljs-built_in">Math</span>.random() * activeWisdomPool.length);
        } <span class="hljs-keyword">while</span> (randomIndex === lastDrawnIndex &amp;&amp; activeWisdomPool.length &gt; <span class="hljs-number">1</span>);

        lastDrawnIndex = randomIndex;
        <span class="hljs-keyword">const</span> card = activeWisdomPool[randomIndex];

        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'deck-title'</span>).innerText = card.title;
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'deck-quote'</span>).innerText = <span class="hljs-string">`"<span class="hljs-subst">${card.quote}</span>"`</span>;
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'deck-number'</span>).innerText = <span class="hljs-string">`Card #<span class="hljs-subst">${<span class="hljs-built_in">String</span>(card.id).padStart(<span class="hljs-number">2</span>, <span class="hljs-string">'0'</span>)}</span> of 99 [<span class="hljs-subst">${card.tag}</span>]`</span>;

        container.style.opacity = <span class="hljs-string">'1'</span>;
      }, <span class="hljs-number">150</span>);
    }
  </span><span class="hljs-tag">&lt;/<span class="hljs-name">script</span>&gt;</span>
