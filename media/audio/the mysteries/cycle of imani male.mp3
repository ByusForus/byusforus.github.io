      <span class="hljs-attribute">background</span>: <span class="hljs-built_in">rgba</span>(<span class="hljs-number">14</span>, <span class="hljs-number">14</span>, <span class="hljs-number">14</span>, <span class="hljs-number">0.9</span>);
      <span class="hljs-attribute">padding</span>: <span class="hljs-number">32px</span> <span class="hljs-number">20px</span>;
