    }

    <span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">playArchivedStream</span>(<span class="hljs-params">srcUrl, sessionTitle</span>) </span>{
      <span class="hljs-keyword">const</span> liveVideo = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">'live-video-player'</span>);
