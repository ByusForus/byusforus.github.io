          <span class="hljs-tag">&lt;<span class="hljs-name">p</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"card-message-text"</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"deck-quote"</span>&gt;</span>
